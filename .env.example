DATABASE_URL="postgresql://panzeri:panzeri@localhost:5432/panzeri_run?schema=public"
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
API_PORT=3333
NEXT_PUBLIC_API_URL="http://localhost:3333"
EXPO_PUBLIC_API_URL="http://localhost:3333"

APP_PUBLIC_URL="https://sua-api.exemplo.com"
STUDENT_APP_URL="https://seu-app-de-alunos.exemplo.com - endereco do app/PWA que as alunas usam (diferente do endereco da API acima). Usado para trazer a aluna de volta ao app depois de autorizar o Strava. Sem essa variavel, a pagina de confirmacao do Strava nao tem como redirecionar de volta."

# Polar AccessLink: preencher no servico da API apos cadastrar o redirect URL abaixo.
POLAR_CLIENT_ID=""
POLAR_CLIENT_SECRET=""
POLAR_REDIRECT_URI="https://agenteselton-panzeri-run-api.hbljgk.easypanel.host/polar/callback"
# 32 bytes em hexadecimal (64 caracteres), gerados fora do repositorio.
POLAR_TOKEN_ENCRYPTION_KEY=""
ASAAS_API_KEY="chave de API do Asaas"
ASAAS_SANDBOX="true"
ASAAS_WEBHOOK_TOKEN="token de autenticacao configurado no webhook do Asaas"
# 26/08: assinatura comprada dentro do app nativo (Apple IAP / Google Play Billing), via RevenueCat.
REVENUECAT_WEBHOOK_SECRET="secret configurado no webhook do RevenueCat (Project settings > Webhooks)"

TELEGRAM_BOT_TOKEN="token do bot gerado pelo BotFather"
TELEGRAM_CHAT_ID="id do chat que recebe os avisos"

ANTHROPIC_API_KEY="chave de API da Anthropic (console.anthropic.com) - usada pelo agente de prescricao de treinos. Obrigatoria: sem essa variavel a geracao de treino falha (nao ha mais motor deterministico de fallback, removido de proposito)."

RESEND_API_KEY="chave de API do Resend (resend.com) - usada para enviar e-mails automaticos e mensagens do treinador. Sem essa variavel, o envio de e-mail fica desativado."
RESEND_FROM_EMAIL="Panzeri Run <avisos@seudominio.com>"
# 27/08: segredo do webhook de entrega (Resend dashboard > Webhooks > seu endpoint > Signing Secret,
# comeca com "whsec_"). Sem essa variavel, o endpoint /messaging/resend/webhook rejeita tudo.
RESEND_WEBHOOK_SECRET="whsec_... (Resend dashboard > Webhooks)"
# 28/08: chave permanente de leitura pra investigacao/diagnostico direto em producao (GET
# /coach-tools/*), sem depender de token de sessao do navegador do treinador (expira rapido).
# So' leitura, nunca cria/altera/apaga nada. Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLAUDE_TOOLING_API_KEY="chave aleatoria longa, gerada uma unica vez"

# 05/10/2026: backup diario do banco CRIPTOGRAFADO (AES-256-GCM) no Cloudflare R2, retencao de 14 dias. NAO e mais enviado por e-mail.
# Sem QUALQUER uma destas variaveis o backup automatico falha com aviso (nunca silenciosamente). Ver RUNBOOKS/2026-10-05-BACKUP-RESTORE.md.
BACKUP_ENCRYPTION_KEY="64 caracteres hex (32 bytes), gerada uma unica vez: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\" — GUARDE FORA DO SERVIDOR; sem ela os backups sao irrecuperaveis. Chave propria, nunca a do Polar."
R2_ACCOUNT_ID="ID da conta Cloudflare (painel R2 > Overview)"
R2_BUCKET="nome do bucket privado de backups"
R2_ACCESS_KEY_ID="Access Key ID de um API Token R2 restrito a este bucket (Object Read & Write)"
R2_SECRET_ACCESS_KEY="Secret Access Key do mesmo token"

# Token de autenticacao interna para o Panzeri Intelligence (Léo).
# Configurar o mesmo valor no EasyPanel do Panzeri Run e no EasyPanel do Panzeri Intelligence.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PANZERI_RUN_INTERNAL_TOKEN="token longo gerado uma unica vez"

# 05/10/2026 — Strava (conformidade). STRAVA_TOKEN_ENCRYPTION_KEY: 64 hex, chave PROPRIA (nunca a do Polar); sem ela nenhum token Strava
# e' gravado nem lido (a conexao falha com aviso). Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# STRAVA_WEBHOOK_VERIFY_TOKEN: obrigatorio para CRIAR a inscricao do webhook (sem valor padrao). O Strava nao assina os eventos.
STRAVA_CLIENT_ID="id do app no Strava"
STRAVA_CLIENT_SECRET="segredo do app no Strava"
STRAVA_REDIRECT_URI="https://SEU-DOMINIO-DA-API/strava/callback"
STRAVA_TOKEN_ENCRYPTION_KEY="64 caracteres hex"
STRAVA_WEBHOOK_VERIFY_TOKEN="texto aleatorio longo, definido uma vez"

# 08/10/2026 — Wahoo (Etapa 3: SO' conexao OAuth; nenhum treino e' enviado). Sem estas 4 variaveis a Wahoo aparece como
# "Indisponivel" no app. WAHOO_TOKEN_ENCRYPTION_KEY: 64 hex, chave PROPRIA (nunca a da Polar nem a do Strava; o servico recusa chave repetida).
# WAHOO_REDIRECT_URI: exatamente o callback cadastrado no portal da Wahoo (https, caminho /wahoo/callback).
# WAHOO_SCOPES (opcional, padrao "user_read workouts_read offline_data" = identificar a conta, LER treinos e receber o aviso de treino novo). Escrita (workouts_write, plans_*) so' na Etapa 4.
WAHOO_CLIENT_ID="id do app no portal Wahoo"
WAHOO_CLIENT_SECRET="segredo do app no portal Wahoo"
WAHOO_REDIRECT_URI="https://agenteselton-panzeri-run-api.hbljgk.easypanel.host/wahoo/callback"
WAHOO_TOKEN_ENCRYPTION_KEY="64 caracteres hex"
# WAHOO_ENABLED_USER_IDS: PORTA DE HABILITACAO da Wahoo durante a validacao real. Ids de usuario (UUID) separados por virgula; "*" libera a todos;
# vazio/ausente = NINGUEM (configurar as credenciais acima NAO libera a integracao). So' o servidor le; o app nunca recebe a lista.
WAHOO_ENABLED_USER_IDS=""
# Wahoo — leitura de atividades (Etapa 5). WAHOO_WEBHOOK_TOKEN: texto aleatorio longo (>= 16 caracteres), o MESMO cadastrado como webhook_token no portal da Wahoo; sem ele o webhook recusa tudo (a Wahoo nao assina o corpo).
# WAHOO_WEBHOOK_ENABLED=true liga o webhook (DESLIGADO por padrao). No portal: Webhook Enabled = true e URL = https://SEU-DOMINIO-DA-API/wahoo/webhook. WAHOO_FALLBACK_INTERVAL_MINUTES (opcional, padrao 180): rotina de seguranca; aumente quando o webhook estiver ativo (limite da API: 1000 chamadas/h).
WAHOO_WEBHOOK_TOKEN=""
WAHOO_FALLBACK_INTERVAL_MINUTES="180"
# WAHOO_FALLBACK_ENABLED=true liga a rotina automatica de seguranca (DESLIGADA por padrao). O botao "Sincronizar agora" funciona sempre.
WAHOO_WEBHOOK_ENABLED=""
WAHOO_FALLBACK_ENABLED=""
