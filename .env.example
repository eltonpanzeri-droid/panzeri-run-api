DATABASE_URL="postgresql://panzeri:panzeri@localhost:5432/panzeri_run?schema=public"
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
API_PORT=3333
NEXT_PUBLIC_API_URL="http://localhost:3333"
EXPO_PUBLIC_API_URL="http://localhost:3333"

APP_PUBLIC_URL="https://sua-api.exemplo.com"
STUDENT_APP_URL="https://seu-app-de-alunos.exemplo.com - endereco do app/PWA que as alunas usam (diferente do endereco da API acima). Usado para trazer a aluna de volta ao app depois de autorizar o Strava. Sem essa variavel, a pagina de confirmacao do Strava nao tem como redirecionar de volta."

ASAAS_API_KEY="chave de API do Asaas"
ASAAS_SANDBOX="true"
ASAAS_WEBHOOK_TOKEN="token de autenticacao configurado no webhook do Asaas"
# 26/08: assinatura comprada dentro do app nativo (Apple IAP / Google Play Billing), via RevenueCat.
REVENUECAT_WEBHOOK_SECRET="secret configurado no webhook do RevenueCat (Project settings > Webhooks)"

TELEGRAM_BOT_TOKEN="token do bot gerado pelo BotFather"
TELEGRAM_CHAT_ID="id do chat que recebe os avisos"

ANTHROPIC_API_KEY="chave de API da Anthropic (console.anthropic.com) - usada pelo agente de prescricao de treinos. Obrigatoria: sem essa variavel a geracao de treino falha (nao ha mais motor deterministico de fallback, removido de proposito)."

RESEND_API_KEY="chave de API do Resend (resend.com) - usada para enviar e-mails automaticos e mensagens do treinador. Sem essa variavel, o envio de e-mail fica desativado."
RESEND_FROM_EMAIL="Panzeri Run <avisos@seudominio.com>"
# 27/08: segredo do webhook de entrega (Resend dashboard > Webhooks > seu endpoint > Signing Secret,
# comeca com "whsec_"). Sem essa variavel, o endpoint /messaging/resend/webhook rejeita tudo.
RESEND_WEBHOOK_SECRET="whsec_... (Resend dashboard > Webhooks)"

BACKUP_EMAIL_TO="email para onde o backup diario do banco de dados sera enviado. Sem essa variavel, o backup automatico fica desativado."
