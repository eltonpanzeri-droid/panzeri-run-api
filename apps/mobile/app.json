{
  "expo": {
    "name": "Panzeri Run",
    "slug": "panzeri-run",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "panzerirun",
    "userInterfaceStyle": "light",
    "icon": "./assets/brand/icon-ios.png",
    "splash": {
      "image": "./assets/brand/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F0E6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.panzerirun.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.panzerirun.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon-foreground.png",
        "backgroundColor": "#071827"
      }
    },
    "web": {
      "name": "Panzeri Run",
      "shortName": "Panzeri",
      "lang": "pt-BR",
      "themeColor": "#246F91",
      "backgroundColor": "#F4F0E6",
      "display": "standalone",
      "startUrl": "/",
      "favicon": "./assets/brand/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "05a84b0a-c324-4b87-be3b-2cdb43a56e7a"
      },
      "revenueCatAndroidApiKey": ""
    },
    "plugins": [
      "expo-notifications",
      "expo-font"
    ]
  }
}
