generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                               String    @id @default(uuid())
  email                            String    @unique
  passwordHash                     String
  name                             String
  cpf                              String?   @unique
  phone                            String?
  birthDate                        DateTime?
  sex                              String?
  heightCm                         Int?
  weightKg                         Float?
  address                          String?
  education                        String?
  role                             String    @default("student")
  // Codigo sequencial de 7 digitos exibido pro treinador (painel + mensagens do Telegram) pra
  // identificar o aluno sem ambiguidade de nome — puro codigo, sem custo de IA. Gerado pelo banco
  // (sequence), nunca por logica da aplicacao, pra nunca colidir mesmo com dois cadastros
  // simultaneos. Formatado com zeros a esquerda (0000001) na hora de exibir, nunca gravado ja
  // formatado.
  // 18/08: deixou de ter @default(autoincrement()) — antes TODO cadastro (mesmo quem so criava
  // login e sumia, sem entrevista nem pagamento) ganhava um codigo permanente na hora, "virando
  // aluno" oficial sem nunca ter pago nada (relato real do treinador: cadastro fantasma "Daiana"
  // consumiu o codigo 0000039). Agora fica null ate a pessoa realmente pagar (ou receber cortesia
  // manual) — ver BillingService.assignStudentCodeIfNeeded, chamado nos pontos onde
  // subscriptionStatus sai de 'pending' pela primeira vez. A sequence do banco continua existindo
  // (User_studentCode_seq) so que consultada manualmente, nunca mais como DEFAULT da coluna.
  studentCode                      Int?      @unique
  // Preenchido quando a ultima tentativa de gerar a semana (botao da aluna ou do treinador) falhou
  // com a IA e nao gerou nenhum plano novo — limpo (null) na proxima tentativa que tiver sucesso.
  // So existe pra dar visibilidade permanente no painel (coluna "Treino"); antes disso a falha so
  // aparecia no Telegram na hora e sumia — se o treinador nao visse na hora, nunca mais sabia.
  lastPlanGenerationFailedAt       DateTime?
  accountStatus                    String    @default("active")
  subscriptionStatus               String    @default("pending")
  subscriptionUpdatedAt            DateTime  @default(now())
  subscriptionManualOverride       Boolean   @default(false)
  // 27/08: marca quando a PROPRIA aluna pediu cancelamento (botao "Cancelar assinatura" no app,
  // ou desligou o auto-renew na loja via RevenueCat). Diferente de billingSubscription.providerStatus
  // (que e' sobrescrito a cada sincronizacao com o Asaas/RevenueCat) — esse campo nunca e' tocado
  // por nenhum sync, entao sobrevive pra sempre e da pra distinguir "ela pediu" de "a assinatura
  // caiu sozinha" na pagina de Ex-alunos, mesmo dias/semanas depois.
  subscriptionCancelRequestedAt    DateTime?
  // 11/09: pesquisa de saída (exit survey) preenchida pelo aluno ao cancelar.
  // cancelReason: sem_tempo | sem_resultado | preco | pausa | objetivo | tecnico | outro
  // cancelWouldReturn: sim | talvez | nao
  cancelReason                     String?
  cancelFeedbackText               String?
  cancelWouldReturn                String?
  // 26/08: quem controla subscriptionStatus pra essa aluna — 'asaas' (site/PWA, cobranca via
  // billing.service.ts) ou 'revenuecat' (assinatura comprada dentro do app nativo iOS/Android,
  // Apple IAP ou Google Play Billing). Existe pra o cron diario do Asaas (billing-sync-scheduler)
  // nunca sobrescrever o status de quem assinou pela loja, e vice-versa — os dois sistemas nunca
  // devem decidir o status da mesma aluna ao mesmo tempo.
  subscriptionProvider             String    @default("asaas")
  acceptedTermsAt                  DateTime?
  acceptedPrivacyAt                DateTime?
  acceptedExerciseResponsibilityAt DateTime?
  lastRoutineChangeAt              DateTime?
  refreshTokenHash                 String?
  // Token de push (Expo) do ultimo celular em que o aluno fez login com notificacao habilitada —
  // pedido do treinador 16/08 (primeiro passo do "o que mais precisamos fazer"). Sobrescrito a
  // cada novo registro; um aluno so recebe push no aparelho mais recente. Null = nunca autorizou
  // notificacao, ou o app ainda nao registrou (versao antiga do app instalada).
  expoPushToken                    String?
  // Fase 0 Data Layer: atribuição de aquisição capturada no momento do cadastro.
  // sessionId = funnelSessionId do PWA — vincula ao FunnelEvent via WHERE sessionId = attrib->>'sessionId'.
  // Nota: FunnelEvent.journeyId (cross-device, nunca implementado) é diferente deste campo.
  // Estrutura: { sessionId?, source?, medium?, campaign?, content?, referrer?, fbclid?, gclid? }
  acquisitionAttribution           Json?
  // Controle de tentativas de "Gerar treino da semana" pelo proprio aluno (pedido do treinador
  // 16/08 — nao chamar a IA toda vez que o aluno aperta o botao, e nao deixar tentativas infinitas
  // batendo timeout sem limite). Reseta sozinho quando generationWeekStart nao bate mais com a
  // semana-alvo calculada (ver TrainingPlansService.doGenerateCurrentWeekOnDemand). Base: 2
  // tentativas por semana; generationExtraAttempts e liberado manualmente pelo treinador no
  // painel quando o aluno esgota as duas (ex: pra pedir um teste). generationExhaustedAlertSent
  // evita mandar o mesmo alerta de Telegram repetido a cada nova tentativa bloqueada.
  generationWeekStart              DateTime?
  generationAttemptsUsed           Int       @default(0)
  generationExtraAttempts          Int       @default(0)
  lastGenerationAttemptAt          DateTime?
  generationExhaustedAlertSent     Boolean   @default(false)
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt

  healthProfile       HealthProfile?
  preferences         UserPreferences?
  availability        WeeklyAvailability[]
  tests               FitnessTest[]
  plans               TrainingPlan[]
  workouts            WorkoutCompletion[]
  achievements        UserAchievement[]
  passwordResetTokens PasswordResetToken[]
  loginLinkTokens     LoginLinkToken[]
  notifications       UserNotification[]
  messageLogs         MessageLog[]
  reassessments       Reassessment[]
  evolutionReports    EvolutionReport[]
  contextEvents       ContextEvent[]
  billingEvents       BillingEvent[]
  onboardingInterview OnboardingInterview?
  billingSubscription BillingSubscription?
  couponRedemptions   CouponRedemption[]
  coachReports        CoachReport[]
  studentDirectives   StudentDirective[]
  coachChatMessages   CoachChatMessage[]
  targetRaces         TargetRace[]
  painReports         PainReport[]
  profileEvents       StudentProfileEvent[]
  observations        StudentObservation[]
  weeklyCheckIns      WeeklyCheckIn[]
  funnelEvents        FunnelEvent[]
  menstrualProfile    MenstrualProfile?
  menstrualCycleLogs  MenstrualCycleLog[]
  menstrualDailyLogs  MenstrualDailyLog[]

  // 04/09: achado numa revisao pensando em escala — nao existia indice nenhum pros filtros mais
  // usados (painel do treinador, prospectos, crons diarios), todos batem em (role,
  // subscriptionStatus, accountStatus) juntos ou em subconjuntos disso. A 1000 linhas o Postgres
  // ainda resolve rapido sem indice (tabela pequena), mas fica barato garantir isso agora em vez
  // de esperar a base crescer alem disso.
  @@index([role, subscriptionStatus, accountStatus])
}

model BillingProviderConfig {
  provider       String   @id
  externalPlanId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BillingSubscription {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id])
  provider               String    @default("asaas")
  externalCustomerId     String?
  externalSubscriptionId String?   @unique
  externalChargeId       String?   @unique
  checkoutUrl            String?
  // URL da fatura PENDENTE/ATRASADA atual no Asaas — populado quando status muda para overdue
  // (via webhook ou refreshFromAsaas), limpo quando volta para active. Nunca é o checkoutUrl
  // antigo: aponta especificamente para a cobrança que precisa de ação agora. Usado pelo
  // subscriptionContext da API; nunca armazenado diretamente em UserNotification.
  overdueInvoiceUrl      String?
  providerStatus         String    @default("new")
  lastNotificationToken  String?
  nextChargeAt           DateTime?
  // Fase 0 Data Layer: timestamp do primeiro pagamento confirmado. Imutável após primeira escrita.
  // Permite calcular LTV real, cohort analysis, tempo exato até conversão.
  firstPaidAt            DateTime?
  // Fase 0 Data Layer: ID do pagamento que marcou o firstPaidAt. Único, permite deduplicação de webhook.
  firstPaidPaymentId     String?   @unique
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model OnboardingInterview {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id])
  answers                Json      @default("{}")
  currentStep            Int       @default(0)
  // 18/08: "completedAt" continua significando a entrevista COMPLETA (detalhada, pos-pagamento).
  // quickIntakeCompletedAt marca a etapa nova, as 5 perguntas rapidas pre-pagamento (Bloco 2 da
  // reformulacao de onboarding) — mesma tabela/JSON de respostas, so um marco a mais. Todo lugar
  // que hoje decide "a pessoa ja terminou a entrevista ANTES de pagar" (nivel de prospecto, aviso
  // de entrevista incompleta, funil) passa a olhar pra esse campo, nao mais pro completedAt.
  quickIntakeCompletedAt DateTime?
  completedAt            DateTime?
  // 25/09 (Passo 3, correcao de comparabilidade longitudinal): versao do instrumento que produziu
  // este conjunto de respostas. Nulo = entrevista concluida antes deste versionamento existir
  // (legado, versao indeterminada por definicao — nunca inferida retroativamente). Preenchido a
  // partir de agora com ONBOARDING_INTERVIEW_VERSION (me.service.ts) no momento da conclusao.
  interviewVersion       Int?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model Reassessment {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id])
  answers             Json      @default("{}")
  currentStep         Int       @default(0)
  completedAt         DateTime?
  evolutionSummary    String?
  evolutionWins       Json?
  evolutionConcerns   Json?
  // 25/09 (Passo 3): versao do instrumento de reavaliacao que produziu "answers". Nulo = reavaliacao
  // concluida com o instrumento antigo de 10 perguntas rasas (antes deste versionamento existir) —
  // legado, nunca reclassificado retroativamente. REASSESSMENT_INSTRUMENT_VERSION (reassessment-
  // trajectory.ts) e' gravado aqui a cada complete()/reopen()+complete() a partir de agora. So' com
  // esta versao a reavaliacao reaplica os 17 ratings, objetivo e dor com as MESMAS chaves canonicas
  // da entrevista inicial — versoes antigas nao tem esses campos, e isso e' tratado como ausencia
  // real (missing), nunca como zero.
  reassessmentVersion Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  evolutionReport EvolutionReport?

  @@index([userId, createdAt])
}

// 25/09 (Passo 3): relatorio de evolucao PERSISTIDO, gerado uma vez por reavaliacao concluida.
// Existe para nao pagar uma chamada de IA toda vez que o agente de prescricao precisar da
// trajetoria de meses do aluno — ele consulta este registro, nunca chama o EvolutionAgentService
// de novo. "trajectorySnapshot" e' a camada deterministica (RAW DATA -> MATEMATICA) que ALIMENTOU
// a interpretacao da IA — guardada para auditoria e para o proprio agente de prescricao consumir
// sem recalcular. "invalidatedAt" marca quando a Reassessment de origem foi reaberta (reopen) e
// ainda nao foi reconcluida — enquanto nao-nulo, este relatorio NAO deve ser tratado como
// interpretacao valida do estado atual (ver ReassessmentService.reopen/complete).
model EvolutionReport {
  id                 String       @id @default(uuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id])
  reassessmentId     String       @unique
  reassessment       Reassessment @relation(fields: [reassessmentId], references: [id])
  trajectorySnapshot Json
  summary            String
  wins               Json
  concerns           Json
  domainObservations Json?
  invalidatedAt      DateTime?
  createdAt          DateTime     @default(now())

  @@index([userId, createdAt])
}

model StudentDirective {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  content   String
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, active])
}

model StudentObservation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, active])
}

model CoachChatMessage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// 18/08: "link magico" pros e-mails de aquecimento de prospecto ("Continuar de onde parei") —
// mesmo padrao de seguranca do PasswordResetToken (token bruto so existe no e-mail, banco guarda
// so o hash; expira; uso unico). Nunca reaproveitado entre e-mails: cada envio gera um token novo.
model LoginLinkToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model UserNotification {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  title       String
  message     String
  type        String    @default("info")
  // Acao semantica interna que o app executa ao tocar na notificacao (ex: 'billing_regularize',
  // 'training_view'). Nunca uma URL externa — a URL real e resolvida autenticada via API no
  // momento do clique, garantindo que sempre aponta para o estado atual correto.
  action      String?
  // ID do evento externo que originou esta notificacao (ex: payment.id do Asaas). Usado como
  // chave primaria de deduplicacao: o mesmo evento nunca gera duas notificacoes, independente
  // de quantas vezes o webhook ou o cron reprocessar o mesmo aluno.
  externalRef String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
}

model MessageLog {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  channel           String
  trigger           String
  subject           String?
  content           String
  status            String    @default("sent")
  errorDetail       String?
  createdAt         DateTime  @default(now())
  // 27/08: id que a Resend devolve no envio — correlaciona esse registro com os eventos que
  // chegam depois pelo webhook (delivered/bounced/complained/opened). "status" acima so' reflete
  // se a Resend ACEITOU processar o envio, nao se realmente chegou na caixa de entrada — sem
  // isso, um e-mail "sent" podia ter simplesmente batido num endereco inexistente sem ninguem
  // nunca saber.
  resendEmailId     String?
  deliveryStatus    String?
  deliveryUpdatedAt DateTime?

  @@index([userId, createdAt])
  @@index([trigger, createdAt])
  @@index([resendEmailId])
}

model HealthProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  systolic          Int?
  diastolic         Int?
  diabetes          Boolean?
  previousSurgeries String?
  previousInjuries  String?
  healthProblems    String?
  medications       String?
  averageSleep      String?
  stressLevel       String?
  anxietyLevel      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model UserPreferences {
  id                  String    @id @default(uuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id])
  preferredModalities String[]
  otherModalities     String[]
  trainingLocations   String[]
  mainGoal            String
  targetRaceDate      DateTime?
  strengthAddOn       String?
  experienceLevel     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model WeeklyAvailability {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  weekday           Int
  noTraining        Boolean  @default(false)
  modalities        String[]
  availableMin      Int?
  modalityDurations Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, weekday])
}

model FitnessTest {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  testType         String   @default("3km")
  totalSeconds     Int
  avgHeartRate     Int?
  maxHeartRate     Int?
  environment      String
  vo2maxEstimated  Float
  vvo2Kmh          Float
  paceSecondsPerKm Int
  notes            String?
  createdAt        DateTime @default(now())
}

model TrainingPlan {
  id               String            @id @default(uuid())
  // Codigo sequencial de rastreio (pedido do treinador 16/08) — um numero de controle por
  // PRESCRICAO (cada geracao/regeneracao de semana cria um TrainingPlan novo, o anterior fica
  // arquivado), nao por aluno. Mesmo padrao de User.studentCode: sequence do banco, nunca
  // reaproveitado. Existe so pra permitir "aluna X relatou um problema no treino numero tal"
  // como referencia inequivoca em conversa/suporte — nao tem nenhum uso logico no sistema.
  planCode         Int               @unique @default(autoincrement())
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  name             String
  goal             String
  status           String            @default("active")
  version          Int               @default(1)
  startDate        DateTime
  endDate          DateTime?
  generatedBy      String            @default("mock")
  inputSnapshot    Json
  aiRecommendation String?
  createdAt        DateTime          @default(now())
  sessions         TrainingSession[]
  weeklyCheckIns   WeeklyCheckIn[]
}

model TrainingExecutionInsight {
  id        String   @id @default(uuid())
  userId    String
  planId    String   @unique
  summary   Json
  items     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model TrainingSession {
  id                  String             @id @default(uuid())
  planId              String
  plan                TrainingPlan       @relation(fields: [planId], references: [id])
  userId              String
  scheduledDate       DateTime
  weekday             Int
  modality            String
  title               String
  sessionType         String?
  locationSuggestion  String?
  durationMin         Int?
  distanceKm          Float?
  intensityZone       String?
  paceMinSec          String?
  structure           Json
  notes               String?
  recommendations     String?
  videoRefs           String[]
  // Preenchido quando esta sessao especifica saiu da rotina/tempo que o aluno combinou (dia a
  // mais, ou duracao diferente) sem nenhuma diretriz do gerente tecnico explicando o motivo —
  // mostrado pro aluno como aviso na tela do treino, pedindo pra ele contar no feedback se deu
  // pra realizar e como se sentiu. Null quando a sessao segue a rotina normalmente (a grande
  // maioria). Nao bloqueia nada, so marca — ver [[training_plans.service.ts generateWeek]].
  routineMismatchNote String?
  createdAt           DateTime           @default(now())
  // Correcao definitiva do ciclo de vida da prescricao (25/09/2026, Passo 2 fechado). Origem real
  // desta sessao — 'agent' (gerada/regenerada pelo prescription-agent), 'coach_manual' (treinador
  // criou direto, sem passar pelo agente) ou 'student_extra' (aluno registrou treino extra por
  // conta propria). Nullable de proposito: registros criados ANTES desta coluna existir ficam
  // null (desconhecido) — nunca inventamos origem retroativa pra dado legado. Novas sessoes
  // sempre recebem um valor real nos 3 pontos de criacao (generateWeek/regenerateSession,
  // createManualSession, addStudentExtraSession).
  origin              String?
  // Quando um treinador edita manualmente (updateTrainingSession) uma sessao que JA tem
  // completion, guardamos aqui um snapshot append-only do que a prescricao era ANTES da edicao —
  // nunca sobrescrevemos silenciosamente a prescricao associada a uma execucao ja registrada (ver
  // secao 18 do fechamento do Passo 2). Array de objetos {editedAt, modality, durationMin,
  // distanceKm, paceMinSec, structure}. Null/vazio quando a sessao nunca foi editada apos ter
  // completion. NAO e' um sistema de auditoria generico — so' existe pra esse caso especifico.
  prescriptionHistory Json?
  updatedAt           DateTime           @updatedAt
  completion          WorkoutCompletion?

  // 09/09 — indice para queries de evolucao do atleta (busca por usuario + ordem cronologica).
  // Sem isso a query principal de evolucao faz full-scan em TrainingSession inteira.
  @@index([userId, scheduledDate])
}

model WorkoutCompletion {
  id                     String           @id @default(uuid())
  userId                 String
  user                   User             @relation(fields: [userId], references: [id])
  sessionId              String?          @unique
  session                TrainingSession? @relation(fields: [sessionId], references: [id])
  completedAt            DateTime         @default(now())
  status                 String
  durationMin            Float?
  distanceKm             Float?
  avgPaceSecondsKm       Int?
  avgHeartRate           Int?
  maxHeartRate           Int?
  perceivedEffort        Int?
  // "satisfaction" (original, 07/2026) passou a representar especificamente a satisfacao em FAZER
  // o treino (dimensao 2 de 4) — mantido sem renomear pra preservar historico. As outras 3
  // dimensoes (19/08, pedido do treinador: pergunta vaga = aluno perdido, igual comando vago pra
  // IA) sao colunas novas. Todas usam a mesma escala de 5 categorias (amei..detestei), exceto
  // satisfactionCarga que usa uma escala propria de adequacao (muito_leve..muito_pesada) — ver
  // SATISFACTION_SCORE/CARGA_SCORE em workout-completions.service.ts pra conversao numerica.
  satisfaction           String? // dimensao 2 historica: satisfacao em FAZER o treino — coletada ate 10/09/2026; substituida por postWorkoutFeeling
  satisfactionElaboracao String? // dimensao 1: satisfacao com a ELABORACAO do treino (v1: obrigatoria a partir de 11/09)
  satisfactionCapacidade String? // dimensao 3: satisfacao com COMO CONSEGUIU fazer (v1: obrigatoria a partir de 11/09)
  satisfactionCarga      String? // dimensao 4 historica: carga adequada? — coletada ate 10/09/2026; nao mais coletada na v1

  painFlag String? // none | leve | moderado | forte ('moderado' adicionado na v1)

  // Feedback v1 (11/09/2026) — bloco 1: estado pre-treino
  // 1=extremo negativo, 5=extremo positivo (ver labels em App.tsx/prescription-agent para cada variavel)
  preSleepQuality    Int? // 1=muito ruim, 5=excelente
  prePhysicalFatigue Int? // 1=muito baixo, 5=muito alto (cansaco fisico)
  preStressLevel     Int? // 1=muito baixo, 5=muito alto (estresse)
  preMotivation      Int? // 1=muito baixa, 5=muito alta

  // Feedback v1 (11/09/2026) — bloco 2: experiencia da sessao
  postWorkoutFeeling Int? // 1=muito mal, 5=muito bem (sensacao imediatamente apos terminar)

  // Feedback v1 (11/09/2026) — bloco 3: dor
  painTiming String? // condicional (so preenchido quando painFlag != 'none'):
  // ja_comecei_sentindo | comeco_passou | comeco_continuou |
  // durante_passou | durante_continuou | so_depois

  // Feedback v2 (24/09/2026) — reestruturacao do feedback individual do treino, pedido explicito
  // do treinador. REGRA CANONICA DAS ESCALAS 1-5 a partir daqui (e retroativamente documentada
  // pras que ja existiam): 5 = MAIOR intensidade/quantidade/presenca da variavel perguntada.
  // NUNCA inverter pra "5 = sempre bom" — cansaco 5 = muito cansado, estresse 5 = muito estressado,
  // sono 5 = excelente (aqui sim "bom" e' a propria intensidade perguntada). Isso e' proposital:
  // nos graficos futuros a altura da linha representa "quanto daquela variavel existe", nao uma
  // escala universal de bom/ruim. Ver GLOSSARIO_METRICAS.md e memoria feedback_v2_scale_convention.

  // Bloco SONO (5 variaveis, cada uma preservada individualmente — nunca so' um score agregado).
  // preSleepQuality (acima) e' a pergunta 1 (qualidade), mantida sem mudanca de coluna/semantica.
  // sleepDurationCategory: pergunta 2 — CATEGORICA, nao e' escala de intensidade 1-5 e nunca deve
  // ser interpretada como "quanto maior, melhor" (dormir demais nao e' "melhor" que a faixa ideal).
  // Valores: menos_5h | 5_a_6h | 6_a_7h | 7_a_8h | 8_a_9h | mais_9h.
  sleepDurationCategory      String?
  // Representacao numerica auxiliar da categoria acima (ponto medio da faixa em horas, ex: "6_a_7h"
  // -> 6.5), gravada so' pra facilitar calculo futuro — NAO e' uma escala de intensidade, e' so' a
  // transcricao numerica direta da categoria escolhida (sem formula, sem interpretacao).
  sleepDurationHoursEstimate Float?
  // Pergunta 3 — irregularidade do horario de dormir vs habitual. 5 = mais irregular.
  sleepScheduleIrregularity  Int?
  // Pergunta 4 — o quanto o sono foi interrompido durante a noite. 5 = mais interrompido.
  sleepInterruption          Int?
  // Pergunta 5 — dificuldade para pegar no sono. 5 = mais dificuldade.
  sleepDifficulty            Int?

  // Bloco ESTADO ANTES DO TREINO. prePhysicalFatigue (acima) = pergunta 6, mantida sem mudanca.
  // preStressLevel (acima) = pergunta 8: ADAPTADA a partir do feedbackVersion 2 — deixou de medir
  // "no instante antes de comecar" e passou a medir "no ultimo dia" (mesma coluna, janela temporal
  // diferente; direcao inalterada, 5 = mais estresse). preMotivation (acima) = pergunta 9: ADAPTADA,
  // redacao mais concreta ("vontade de fazer o treino de hoje"), mesma coluna e direcao (5 = mais
  // vontade) — conceitualmente e' a mesma variavel de motivacao que ja existia.
  // Pergunta 7, NOVA — cansaco mental antes de comecar. 5 = mais cansaco mental.
  preMentalFatigue Int?

  // Bloco RESPOSTA AO TREINO. perceivedEffort (RPE, acima) = pergunta 10, mantido (escala 1-10,
  // nunca convertida pra 1-5). satisfactionElaboracao (acima) = pergunta 11, mantido (mesma coluna
  // e mesma escala amei..detestei ja convertida 1-5 via SATISFACTION_SCORE) — so' o rotulo exibido
  // ao aluno muda pra "Pessima..Excelente".
  //
  // Pergunta 12, SUBSTITUI satisfactionCapacidade pra sessoes feedbackVersion>=2 — a antiga media
  // "quao satisfeito com a execucao" (bom/ruim), a nova mede DIRECAO DO DESVIO em relacao ao
  // prescrito, escala com significado proprio: 1=fiz bem menos, 2=um pouco menos, 3=como prescrito
  // (ponto de referencia, NAO "neutro"), 4=um pouco mais, 5=bem mais. Nao interpretar 5 como
  // "melhor execucao" — e' so' "mais que o prescrito". satisfactionCapacidade continua existindo e
  // sendo lida em sessoes feedbackVersion 1 (historico), nao e' mais coletada a partir da v2.
  executionVsPrescribed Int?

  // Pergunta 13, SUBSTITUI postWorkoutFeeling pra sessoes feedbackVersion>=2 — NAO reaproveita a
  // coluna antiga porque a direcao da escala e' OPOSTA: postWorkoutFeeling era 1=muito mal,
  // 5=muito bem (positivo=bom); a pergunta nova mede cansaco fisico provocado pelo treino,
  // 1=muito pouco, 5=extremamente (positivo=mais cansaco). Reaproveitar a mesma coluna teria
  // corrompido silenciosamente qualquer media historica misturando v1 e v2. postWorkoutFeeling
  // continua existindo e sendo lida em sessoes feedbackVersion 1.
  postPhysicalFatigue       Int?
  // Pergunta 14, NOVA — cansaco mental provocado pelo treino. 5 = mais cansaco mental.
  postMentalFatigue         Int?
  // Pergunta 15, SUBSTITUI o campo "postWorkoutMood" que vivia em details (JSON, sem coluna
  // propria, 12/09/2026) — promovido a coluna real. Experiencia emocional DURANTE o treino.
  // 1=muito mal, 5=muito bem. Leitura de sessoes antigas (feedbackVersion 1) deve continuar
  // buscando o valor em details.postWorkoutMood — nunca reescrito, so' lido de outro lugar.
  emotionalExperienceDuring Int?
  // Pergunta 16, NOVA — mudanca percebida no estado mental comparando antes x depois do treino.
  // Nao e' redundante com a 15 (que mede a experiencia DURANTE, nao a mudanca). 1=muito pior,
  // 5=muito melhor (aqui "melhor" e' o proprio sentido da pergunta, nao inversao de intensidade).
  mentalStateChangePrePost  Int?

  // Versionamento: incrementar so quando o significado de uma variavel mudar de verdade.
  // v1 = estrutura de 11/09/2026 (blocos 1-2-3, 8 perguntas obrigatorias + dor).
  // v2 = estrutura de 24/09/2026 (16 perguntas, blocos Sono/Estado antes/Resposta ao treino) —
  // ver tabela mantida/adaptada/substituida/nova completa em GLOSSARIO_METRICAS.md.
  feedbackVersion Int @default(1)

  notes   String?
  details Json?
  source  String  @default("manual")

  // Correcao definitiva do ciclo de vida da prescricao (25/09/2026) — "Fiz, mas mudei o treino"
  // (status continua sendo o valor legado 'adjusted', so o ROTULO exibido mudou, sem migration
  // destrutiva). Motivos de multipla escolha (ids curtos, ver ADJUSTMENT_REASON_OPTIONS no
  // mobile), so' preenchido quando status='adjusted'. NAO altera TrainingSession — a prescricao
  // original permanece intacta; isso so' descreve o PORQUE da execucao ter sido diferente.
  adjustmentReasons           String[]
  adjustmentComment           String?
  // So' preenchido quando um dos adjustmentReasons for "preferi fazer outro treino".
  adjustmentPreferredActivity String?

  // 25/09/2026 (Passo 4 — contexto longitudinal): quando esta e' a PRIMEIRA execucao valida
  // registrada depois de um retorno-apos-lacuna (ver ContextEvent), fica marcada aqui — metadado
  // puro, nao altera nenhum campo semantico existente de WorkoutCompletion. Preenchido por
  // ContextEventsService.linkFirstObservationIfPending, nunca pelo proprio fluxo de salvar feedback.
  firstObservationAfterGapEvent   ContextEvent? @relation(fields: [firstObservationAfterGapEventId], references: [id])
  firstObservationAfterGapEventId String?

  @@index([firstObservationAfterGapEventId])
}

// 25/09/2026 (Passo 4) — representacao estruturada de eventos de contexto externos a trajetoria de
// treino (trabalho, viagem, familia, saude, dor/lesao, sono, mudanca de rotina) e, como primeira
// aplicacao concreta, do questionario de RETORNO APOS LACUNA (ver GAP_RETURN_THRESHOLD_DAYS em
// context-event-types.ts). Especificacao alinhada a ATHLETE_STATE_MODEL.md secoes 12-15 (ja escrita
// por Elton antes desta implementacao): guarda o RELATO estruturado, nunca a causa inferida.
model ContextEvent {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // work | routine_change | travel | family_personal | health | illness | pain_injury | sleep | other
  type    String
  subtype String?

  // Intervalo do evento em si (ex: data de inicio da viagem/afastamento). endedAt null = evento
  // ainda ativo (nunca forcamos uma data final quando ela nao existe). Para eventos de retorno-
  // apos-lacuna, startedAt/endedAt descrevem a LACUNA (dia seguinte a ultima execucao valida ate a
  // data do relato de retorno) — ver gapAnchorDate abaixo pra' o ponto exato de deduplicacao.
  startedAt  DateTime?
  endedAt    DateTime?
  reportedAt DateTime  @default(now())
  // ongoing | ended
  status     String    @default("ongoing")

  // student_reported | coach_reported | reassessment | return_after_gap | system_detected
  // (system_detected reservado para deteccao futura de mudanca-sem-causa-conhecida — nao escrito
  // por nenhum codigo desta implementacao, ver secao 30 do Passo 4).
  source String

  // Texto original do relato (aluno/treinador) — nunca perdido, mesmo quando type/subtype
  // estruturam a mesma informacao. Ver ATHLETE_STATE_MODEL.md secao 13.
  originalText String?

  // Campos exclusivos do questionario de RETORNO APOS LACUNA (source='student_reported' com
  // gapAnchorDate preenchido). Null para ContextEvent manual/generico. Nao vira uma tabela
  // separada de proposito (secao 13 do Passo 4: "evite estruturas duplicadas").
  // Ancora de deduplicacao: a data da ultima execucao valida ANTES da lacuna que gerou este evento
  // — impede perguntar de novo pela mesma lacuna (ver ContextEventsService.getReturnQuestionnaireState).
  gapAnchorDate                   DateTime?
  // none | very_little | some_outside | normal_outside (ver TRAINING_DURING_GAP_OPTIONS)
  trainingDuringGapReported       String?
  // 1 (muito pior) a 5 (muito melhor), autorrelato, nunca calculado
  physicalStateComparedToBefore   Int?
  // 1 (muito menor) a 5 (muito maior), autorrelato, nunca calculado
  mentalReadinessComparedToBefore Int?
  // true assim que uma WorkoutCompletion real for vinculada como "primeira observacao apos a
  // lacuna" (ver WorkoutCompletion.firstObservationAfterGapEventId) — evita vincular mais de uma.
  firstObservationLinkedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firstObservationCompletions WorkoutCompletion[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([userId, gapAnchorDate])
}

model TargetRace {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  name          String
  raceDate      DateTime
  distanceKm    Float
  targetSeconds Int?
  priority      String   @default("principal")
  status        String   @default("em_andamento")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Questionario de contexto sobre a meta (pedido explicito do treinador, 10/08) — escala de 1 a
  // 10, tudo opcional (provas cadastradas antes disso ficam sem essas respostas ate serem
  // editadas). Existe pra IA calibrar TOM e o quanto vale empurrar alem do confortavel, nunca
  // como formula/trava — ver a regra correspondente em prescription-agent.service.ts.
  performanceIntent       Int?
  socialIntent            Int?
  personalImportance      Int?
  perceivedDifficulty     Int?
  dedicationWillingness   Int?
  achievementSatisfaction Int?
  confidenceLevel         Int?
  injuryConcern           Int?
  adjustmentOpenness      Int?
  anxietyLevel            Int?
  isFirstTimeAtDistance   Boolean?

  @@index([userId, status])
}

model PainReport {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  regions            String[]
  regionDetails      Json?
  otherLocation      String?
  intensity          Int
  onsetPattern       String
  persistencePattern String
  // Adicionados 18/08 — "investigador de dor guiado" (ideia do proprio treinador, ver
  // panzeri_methodology): a dor esta piorando/estavel/melhorando ao longo dos treinos, e
  // atrapalha o dia a dia fora do treino. Nullable pra nao quebrar relatos antigos.
  worseningTrend     String?
  dailyLifeImpact    String?
  previousPainStatus String?
  resolvedRegions    String[]
  comment            String?
  createdAt          DateTime @default(now())

  @@index([userId, createdAt])
}

// 31/08: check-in obrigatorio antes de gerar a proxima semana (pedido do treinador) — junta duas
// coisas: (a) confirmacao de que o aluno registrou tudo que fez/nao fez na semana que esta
// terminando, com os numeros reais (previsto/mudou modalidade/diferente/sem registro) capturados
// no momento, e (b) respostas em escala sobre a semana como um todo (nao por sessao — ja existe
// avaliacao por sessao em WorkoutCompletion). Guardado em tabela propria, com numero (nao texto
// livre), de proposito: o treinador quer poder analisar padrao de adesao/engajamento/risco de
// abandono ou lesao no medio prazo, o que exige dado limpo e consultavel, nao um resumo em prosa.
// 11/09: expandido de 3 para 15 perguntas em 3 blocos (checkinVersion=2). As 3 colunas
// originais ficam nullable para nao quebrar registros antigos (v1). Sentinel de "pulou" em v1:
// elaborationSatisfaction===0; em v2: checkinSkipped=true. A IA recebe semDados em ambos os casos.
model WeeklyCheckIn {
  id                          String        @id @default(uuid())
  userId                      String
  user                        User          @relation(fields: [userId], references: [id])
  planId                      String?
  plan                        TrainingPlan? @relation(fields: [planId], references: [id])
  weekStartDate               DateTime
  // Numeros reais da semana, capturados no momento do check-in (nao recalculados depois) — mesma
  // fonte que StravaService.report() ja usa pra montar o relatorio de evolucao, reaproveitados
  // aqui em vez de duplicar a logica de comparacao previsto/feito.
  asPrescribedSessions        Int
  changedModalitySessions     Int
  differentSessions           Int
  missedSessions              Int
  // V1 (3 perguntas, 31/08). Nullable a partir de 11/09 para compat com v2.
  // elaborationSatisfaction===0 era o sentinel de "pulou" no v1 — preservado para leitura.
  elaborationSatisfaction     Int?
  adherenceSatisfaction       Int?
  // nextWeekMotivation compartilhado entre v1 (pergunta 3) e v2 (pergunta 11, bloco 3).
  nextWeekMotivation          Int?
  // V2 Bloco 1: Como foi sua semana (11/09)
  prescriptionLiking          Int?
  prescriptionSuitability     Int?
  perceivedExecution          Int?
  executionSatisfaction       Int?
  postWeekMotivation          Int?
  // V2 Bloco 2: Como voce esta
  weeklySleep                 Int?
  currentPhysicalFatigue      Int?
  weeklyStress                Int?
  routineInterference         Int?
  bodyResponseVsNormal        Int?
  // V2 Bloco 3: Proxima semana (nextWeekMotivation acima + os 4 abaixo + preferencia textual)
  nextWeekConfidence          Int?
  expectedScheduleFeasibility Int?
  expectedPhysicalState       Int?
  // preferredNextWeekTraining: reaproveitada pela v3 (24/09/2026) com um universo de valores NOVO
  // e disjunto do antigo (10 opcoes v2 -> 5 opcoes v3) — checkinVersion diz qual conjunto vale pra
  // aquela linha. Nunca colidem: nenhum id v3 repete um id v2 (ver PREFERRED_TRAINING_OPTIONS_V3
  // no mobile e a lista correspondente em weekly-checkin.service.ts).
  preferredNextWeekTraining   String?

  // V3 (24/09/2026) — check-in semanal reduzido a 9 perguntas: o feedback de cada sessao
  // individual (feedbackVersion v2) agora ja cobre sono/cansaco fisico/cansaco mental/estresse/
  // vontade de treinar/RPE por treino, entao o semanal deixou de repetir isso e passou a focar em
  // percepcao AGREGADA da semana + expectativa pra proxima. MESMA REGRA CANONICA das escalas do
  // feedback individual: 5 = maior intensidade/quantidade da variavel perguntada, nunca invertida
  // pra "5 = sempre bom".
  //
  // Pergunta 4 (bloco 1): exigencia da semana comparada ao normal do proprio aluno. 5 = muito mais
  // exigente. Variavel nova, sem equivalente anterior — futuramente cruzada com carga
  // prescrita/executada, volume, RPE das sessoes e baseline individual.
  weekDemandVsNormal          Int?
  // Pergunta 7 (bloco 3): interferencia ESPERADA da rotina/compromissos na PROXIMA semana
  // (prospectivo). 5 = interferencia muito alta. NAO e' a mesma variavel de routineInterference
  // (acima, v2) nem de expectedScheduleFeasibility (acima, v2) — routineInterference era
  // retrospectivo (olhava pra semana que passou) e tinha a escala invertida (5=nao atrapalhou);
  // expectedScheduleFeasibility perguntava sobre espaco na agenda com escala tambem invertida
  // (5=semana livre). Reaproveitar qualquer uma delas teria misturado silenciosamente semanticas e
  // direcoes de escala diferentes — por isso e' coluna nova.
  expectedRoutineInterference Int?
  // Pergunta 9 (bloco 4): observacao livre e opcional sobre a semana ou a proxima. Substitui
  // qualquer necessidade de inferir isso das perguntas estruturadas.
  freeTextObservation         String?

  // Meta: versao do formulario (1=3 perguntas, 2=15 perguntas, 3=9 perguntas) e flag de skip
  // explicito. Ver tabela completa mantida/adaptada/substituida/retirada/nova em
  // GLOSSARIO_METRICAS.md.
  checkinVersion Int      @default(1)
  checkinSkipped Boolean  @default(false)
  createdAt      DateTime @default(now())

  // Trava a mesma garantia de "um check-in por plano" que o codigo (WeeklyCheckInService.submit)
  // ja tentava manter so' com um findFirst antes do create — achado por auto-revisao: sem isso no
  // banco, duas chamadas quase simultaneas (duplo toque, dois aparelhos) podiam criar duas linhas
  // pro mesmo plano.
  @@unique([userId, planId])
  @@index([userId, createdAt])
}

// 11/09: rastreamento de ciclo menstrual para correlacao com aderencia/dor/desempenho.
// Finalidade: correlacao estatistica (ex: "na fase 1 a aderencia cai X%") — nao diagnostico.
// O agente de treino recebe o contexto como dado geral, nao como regra de prescricao.
// A futura camada de analise de padroes (agente de evolucao) cruzara esses dados com o historico.
model MenstrualProfile {
  id                        String   @id @default(uuid())
  userId                    String   @unique
  user                      User     @relation(fields: [userId], references: [id])
  // Ciclo ativo: true = sim, false = nao/menopausa, null = preferiu nao informar
  hasActiveCycle            Boolean?
  // Uso de anticoncepcional hormonal (null = preferiu nao informar)
  usesHormonalContraceptive Boolean?
  // Tipo quando usa anticoncepcional — identificador semantico (ex: 'pilula_combinada', 'diu_hormonal')
  contraceptiveType         String?
  // Duracao tipica do ciclo (dias do 1o ao proximo 1o dia) — null quando usa hormonal ou nao informou.
  // A partir de 25/09/2026 e' so' o valor DECLARADO pela aluna na configuracao inicial (chute dela);
  // a duracao REAL observada vem de MenstrualCycleService.getCycleOverview(), derivada
  // deterministicamente do historico de MenstrualCycleLog via MathLayer/LongitudinalDynamics —
  // nunca assumindo 28 dias fixos. AVISO: quando usesHormonalContraceptive=true as fases estimadas NAO sao confiaveis
  cycleLengthDays           Int?
  // Duracao tipica da menstruacao — null quando usa hormonal ou nao informou (mesma ressalva acima)
  periodLengthDays          Int?
  // 25/09/2026 (evolucao do acompanhamento menstrual) — campos opcionais adicionais da configuracao
  // inicial. Todos null = "preferiu nao informar", igual ao padrao ja estabelecido acima.
  cycleRegularity           String? // 'regular' | 'irregular' | 'unknown'
  diuType                   String? // 'none' | 'hormonal' | 'non_hormonal'
  menopauseStatus           String? // 'none' | 'perimenopause' | 'menopause'
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

// Um registro por ciclo — agora com inicio E fim (25/09/2026), pra preservar duracao real do
// sangramento e do ciclo. cycleEndDate null = sangramento em curso ou nao informado ainda.
// Sintomas do dia 1 continuam aqui por compatibilidade; sintomas DIARIOS (qualquer dia, nao so o
// dia 1) vivem em MenstrualDailyLog, uma tabela nova e separada — sao conceitos diferentes (evento
// de fronteira do ciclo vs. observacao do dia).
model MenstrualCycleLog {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  // Data do 1o dia — armazenado como DateTime mas representa so a data (horario zerado)
  cycleStartDate DateTime
  // 25/09/2026 — data do ultimo dia do sangramento (mesma convencao: hora zerada). Null = ainda em
  // curso ou nao informado. Permite calcular duracao real do sangramento por ciclo.
  cycleEndDate   DateTime?
  // Sintomas no dia 1 (escala 1–5, opcionais — a aluna pode registrar so a data)
  crampsLevel    Int? // 1=sem cólicas, 5=muito intensa
  energyLevel    Int? // 1=muito baixa, 5=alta
  moodLevel      Int? // 1=muito instavel, 5=muito estavel
  // 25/09/2026 — intensidade do fluxo no dia 1 (opcional). Categorico, nunca virou escala numerica
  // artificial (mesma regra de "categoria nao vira escala continua" do restante do Registry).
  flowIntensity  String? // 'leve' | 'moderado' | 'intenso'
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, cycleStartDate])
}

// 25/09/2026 (evolucao do acompanhamento menstrual) — UM registro por dia (upsert por data), pra
// sintomas poderem ser acompanhados em qualquer dia do ciclo, nao so no dia 1. Fonte canonica que
// alimenta ObservationReaderService (novo VariableSource 'student_menstrual_daily_log') — mesma
// arquitetura de Observation ja usada por WorkoutCompletion/WeeklyCheckIn, nao uma segunda.
model MenstrualDailyLog {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  date          DateTime // dia (hora zerada)
  crampsLevel   Int?
  energyLevel   Int?
  moodLevel     Int?
  flowIntensity String? // 'leve' | 'moderado' | 'intenso' | null (fora do sangramento ou nao informado)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model StravaConnection {
  id           String   @id @default(uuid())
  userId       String   @unique
  athleteId    String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Cache da analise do agente de IA sobre o historico do Strava (StravaAnalysisAgentService).
// Desacoplada de generateWeek() — a analise roda pela sua propria cadencia (mensal por padrao,
// ou a frequencia customizada por aluno definida pelo treinador via chat), nunca mais junto da
// geracao da semana. lastActivityId/analysis ficam nullable porque uma preferencia de frequencia
// pode ser definida antes de qualquer analise real ter rodado para aquele aluno.
model StravaAnalysisCache {
  userId              String   @id
  lastActivityId      String?
  analysis            Json?
  // Frequencia customizada (em dias) definida pelo treinador para este aluno especifico via chat
  // do Gerente Tecnico — null usa o padrao mensal (30 dias, ver StravaAnalysisSchedulerService).
  customFrequencyDays Int?
  updatedAt           DateTime @updatedAt
}

model StravaActivity {
  id             String   @id @default(uuid())
  userId         String
  stravaId       String   @unique
  name           String?
  type           String?
  startDate      DateTime
  distanceKm     Float?
  movingTimeSec  Int?
  // Tempo total decorrido da atividade (inclui paradas reais — semaforo, agua parada etc.),
  // diferente de movingTimeSec (que o proprio Strava ja tenta excluir parada total, mas NAO
  // exclui caminhada, que ainda conta como "em movimento"). Um gap grande entre os dois e sinal
  // de paradas reais; nao ajuda a detectar caminhada dentro do treino.
  elapsedTimeSec Int?
  avgPaceSecKm   Int?
  avgHeartRate   Int?
  maxHeartRate   Int?
  cadence        Int?
  // Ganho de elevacao total (metros) — usado pelo agente de analise do Strava pra contextualizar
  // pace/cadencia mais lentos (subida) em vez de interpretar isso como fadiga ou caminhada.
  elevationGainM Float?
  raw            Json
  createdAt      DateTime @default(now())
}

