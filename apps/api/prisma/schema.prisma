generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                               String    @id @default(uuid())
  email                            String    @unique
  passwordHash                     String
  name                             String
  cpf                              String?   @unique
  phone                            String?
  birthDate                        DateTime?
  sex                              String?
  heightCm                         Int?
  weightKg                         Float?
  address                          String?
  education                        String?
  role                             String    @default("student")
  // Codigo sequencial de 7 digitos exibido pro treinador (painel + mensagens do Telegram) pra
  // identificar o aluno sem ambiguidade de nome — puro codigo, sem custo de IA. Gerado pelo banco
  // (sequence), nunca por logica da aplicacao, pra nunca colidir mesmo com dois cadastros
  // simultaneos. Formatado com zeros a esquerda (0000001) na hora de exibir, nunca gravado ja
  // formatado.
  // 18/08: deixou de ter @default(autoincrement()) — antes TODO cadastro (mesmo quem so criava
  // login e sumia, sem entrevista nem pagamento) ganhava um codigo permanente na hora, "virando
  // aluno" oficial sem nunca ter pago nada (relato real do treinador: cadastro fantasma "Daiana"
  // consumiu o codigo 0000039). Agora fica null ate a pessoa realmente pagar (ou receber cortesia
  // manual) — ver BillingService.assignStudentCodeIfNeeded, chamado nos pontos onde
  // subscriptionStatus sai de 'pending' pela primeira vez. A sequence do banco continua existindo
  // (User_studentCode_seq) so que consultada manualmente, nunca mais como DEFAULT da coluna.
  studentCode                      Int?      @unique
  // Preenchido quando a ultima tentativa de gerar a semana (botao da aluna ou do treinador) falhou
  // com a IA e nao gerou nenhum plano novo — limpo (null) na proxima tentativa que tiver sucesso.
  // So existe pra dar visibilidade permanente no painel (coluna "Treino"); antes disso a falha so
  // aparecia no Telegram na hora e sumia — se o treinador nao visse na hora, nunca mais sabia.
  lastPlanGenerationFailedAt       DateTime?
  accountStatus                    String    @default("active")
  subscriptionStatus               String    @default("pending")
  subscriptionUpdatedAt            DateTime  @default(now())
  subscriptionManualOverride       Boolean   @default(false)
  // 27/08: marca quando a PROPRIA aluna pediu cancelamento (botao "Cancelar assinatura" no app,
  // ou desligou o auto-renew na loja via RevenueCat). Diferente de billingSubscription.providerStatus
  // (que e' sobrescrito a cada sincronizacao com o Asaas/RevenueCat) — esse campo nunca e' tocado
  // por nenhum sync, entao sobrevive pra sempre e da pra distinguir "ela pediu" de "a assinatura
  // caiu sozinha" na pagina de Ex-alunos, mesmo dias/semanas depois.
  subscriptionCancelRequestedAt    DateTime?
  // 11/09: pesquisa de saída (exit survey) preenchida pelo aluno ao cancelar.
  // cancelReason: sem_tempo | sem_resultado | preco | pausa | objetivo | tecnico | outro
  // cancelWouldReturn: sim | talvez | nao
  cancelReason                     String?
  cancelFeedbackText               String?
  cancelWouldReturn                String?
  // 26/08: quem controla subscriptionStatus pra essa aluna — 'asaas' (site/PWA, cobranca via
  // billing.service.ts) ou 'revenuecat' (assinatura comprada dentro do app nativo iOS/Android,
  // Apple IAP ou Google Play Billing). Existe pra o cron diario do Asaas (billing-sync-scheduler)
  // nunca sobrescrever o status de quem assinou pela loja, e vice-versa — os dois sistemas nunca
  // devem decidir o status da mesma aluna ao mesmo tempo.
  subscriptionProvider             String    @default("asaas")
  acceptedTermsAt                  DateTime?
  acceptedPrivacyAt                DateTime?
  // Versao juridica (LEGAL_VERSION, legal/legal-content.ts) vigente no aceite. Null = aceite anterior ao
  // versionamento (05/10/2026): nunca preenchida retroativamente nem usada para forcar novo aceite.
  acceptedTermsVersion             String?
  acceptedPrivacyVersion           String?
  acceptedExerciseResponsibilityAt DateTime?
  lastRoutineChangeAt              DateTime?
  refreshTokenHash                 String?
  // Token de push (Expo) do ultimo celular em que o aluno fez login com notificacao habilitada —
  // pedido do treinador 16/08 (primeiro passo do "o que mais precisamos fazer"). Sobrescrito a
  // cada novo registro; um aluno so recebe push no aparelho mais recente. Null = nunca autorizou
  // notificacao, ou o app ainda nao registrou (versao antiga do app instalada).
  expoPushToken                    String?
  // Fase 0 Data Layer: atribuição de aquisição capturada no momento do cadastro.
  // sessionId = funnelSessionId do PWA — vincula ao FunnelEvent via WHERE sessionId = attrib->>'sessionId'.
  // Nota: FunnelEvent.journeyId (cross-device, nunca implementado) é diferente deste campo.
  // Estrutura: { sessionId?, source?, medium?, campaign?, content?, referrer?, fbclid?, gclid? }
  acquisitionAttribution           Json?
  // Controle de tentativas de "Gerar treino da semana" pelo proprio aluno (pedido do treinador
  // 16/08 — nao chamar a IA toda vez que o aluno aperta o botao, e nao deixar tentativas infinitas
  // batendo timeout sem limite). Reseta sozinho quando generationWeekStart nao bate mais com a
  // semana-alvo calculada (ver TrainingPlansService.doGenerateCurrentWeekOnDemand). Base: 2
  // tentativas por semana; generationExtraAttempts e liberado manualmente pelo treinador no
  // painel quando o aluno esgota as duas (ex: pra pedir um teste). generationExhaustedAlertSent
  // evita mandar o mesmo alerta de Telegram repetido a cada nova tentativa bloqueada.
  generationWeekStart              DateTime?
  generationAttemptsUsed           Int       @default(0)
  generationExtraAttempts          Int       @default(0)
  lastGenerationAttemptAt          DateTime?
  generationExhaustedAlertSent     Boolean   @default(false)
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt

  healthProfile         HealthProfile?
  preferences           UserPreferences?
  availability          WeeklyAvailability[]
  tests                 FitnessTest[]
  plans                 TrainingPlan[]
  workouts              WorkoutCompletion[]
  achievements          UserAchievement[]
  passwordResetTokens   PasswordResetToken[]
  loginLinkTokens       LoginLinkToken[]
  notifications         UserNotification[]
  messageLogs           MessageLog[]
  reassessments         Reassessment[]
  evolutionReports      EvolutionReport[]
  contextEvents         ContextEvent[]
  billingEvents         BillingEvent[]
  onboardingInterview   OnboardingInterview?
  billingSubscription   BillingSubscription?
  couponRedemptions     CouponRedemption[]
  coachReports          CoachReport[]
  studentDirectives     StudentDirective[]
  coachChatMessages     CoachChatMessage[]
  targetRaces           TargetRace[]
  painReports           PainReport[]
  profileEvents         StudentProfileEvent[]
  observations          StudentObservation[]
  reportEntries         StudentReportEntry[]
  weeklyCheckIns        WeeklyCheckIn[]
  funnelEvents          FunnelEvent[]
  menstrualProfile      MenstrualProfile?
  menstrualCycleLogs    MenstrualCycleLog[]
  menstrualDailyLogs    MenstrualDailyLog[]
  rawExternalActivities RawExternalActivity[]
  activityLogs          ActivityLog[]
  nightlySleepLogs      NightlySleepLog[]
  stressCheckins        StressCheckin[]
  shoes                 Shoe[]

  // 04/09: achado numa revisao pensando em escala — nao existia indice nenhum pros filtros mais
  // usados (painel do treinador, prospectos, crons diarios), todos batem em (role,
  // subscriptionStatus, accountStatus) juntos ou em subconjuntos disso. A 1000 linhas o Postgres
  // ainda resolve rapido sem indice (tabela pequena), mas fica barato garantir isso agora em vez
  // de esperar a base crescer alem disso.
  @@index([role, subscriptionStatus, accountStatus])
}

model BillingProviderConfig {
  provider       String   @id
  externalPlanId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BillingSubscription {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id])
  provider               String    @default("asaas")
  externalCustomerId     String?
  externalSubscriptionId String?   @unique
  externalChargeId       String?   @unique
  checkoutUrl            String?
  // URL da fatura PENDENTE/ATRASADA atual no Asaas — populado quando status muda para overdue
  // (via webhook ou refreshFromAsaas), limpo quando volta para active. Nunca é o checkoutUrl
  // antigo: aponta especificamente para a cobrança que precisa de ação agora. Usado pelo
  // subscriptionContext da API; nunca armazenado diretamente em UserNotification.
  overdueInvoiceUrl      String?
  providerStatus         String    @default("new")
  lastNotificationToken  String?
  nextChargeAt           DateTime?
  // Fase 0 Data Layer: timestamp do primeiro pagamento confirmado. Imutável após primeira escrita.
  // Permite calcular LTV real, cohort analysis, tempo exato até conversão.
  firstPaidAt            DateTime?
  // Fase 0 Data Layer: ID do pagamento que marcou o firstPaidAt. Único, permite deduplicação de webhook.
  firstPaidPaymentId     String?   @unique
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model OnboardingInterview {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id])
  answers                Json      @default("{}")
  currentStep            Int       @default(0)
  // 18/08: "completedAt" continua significando a entrevista COMPLETA (detalhada, pos-pagamento).
  // quickIntakeCompletedAt marca a etapa nova, as 5 perguntas rapidas pre-pagamento (Bloco 2 da
  // reformulacao de onboarding) — mesma tabela/JSON de respostas, so um marco a mais. Todo lugar
  // que hoje decide "a pessoa ja terminou a entrevista ANTES de pagar" (nivel de prospecto, aviso
  // de entrevista incompleta, funil) passa a olhar pra esse campo, nao mais pro completedAt.
  quickIntakeCompletedAt DateTime?
  completedAt            DateTime?
  // 25/09 (Passo 3, correcao de comparabilidade longitudinal): versao do instrumento que produziu
  // este conjunto de respostas. Nulo = entrevista concluida antes deste versionamento existir
  // (legado, versao indeterminada por definicao — nunca inferida retroativamente). Preenchido a
  // partir de agora com ONBOARDING_INTERVIEW_VERSION (me.service.ts) no momento da conclusao.
  interviewVersion       Int?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model Reassessment {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id])
  answers             Json      @default("{}")
  currentStep         Int       @default(0)
  completedAt         DateTime?
  evolutionSummary    String?
  evolutionWins       Json?
  evolutionConcerns   Json?
  // 25/09 (Passo 3): versao do instrumento de reavaliacao que produziu "answers". Nulo = reavaliacao
  // concluida com o instrumento antigo de 10 perguntas rasas (antes deste versionamento existir) —
  // legado, nunca reclassificado retroativamente. REASSESSMENT_INSTRUMENT_VERSION (reassessment-
  // trajectory.ts) e' gravado aqui a cada complete()/reopen()+complete() a partir de agora. So' com
  // esta versao a reavaliacao reaplica os 17 ratings, objetivo e dor com as MESMAS chaves canonicas
  // da entrevista inicial — versoes antigas nao tem esses campos, e isso e' tratado como ausencia
  // real (missing), nunca como zero.
  reassessmentVersion Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  evolutionReport EvolutionReport?

  @@index([userId, createdAt])
}

// 25/09 (Passo 3): relatorio de evolucao PERSISTIDO, gerado uma vez por reavaliacao concluida.
// Existe para nao pagar uma chamada de IA toda vez que o agente de prescricao precisar da
// trajetoria de meses do aluno — ele consulta este registro, nunca chama o EvolutionAgentService
// de novo. "trajectorySnapshot" e' a camada deterministica (RAW DATA -> MATEMATICA) que ALIMENTOU
// a interpretacao da IA — guardada para auditoria e para o proprio agente de prescricao consumir
// sem recalcular. "invalidatedAt" marca quando a Reassessment de origem foi reaberta (reopen) e
// ainda nao foi reconcluida — enquanto nao-nulo, este relatorio NAO deve ser tratado como
// interpretacao valida do estado atual (ver ReassessmentService.reopen/complete).
model EvolutionReport {
  id                 String       @id @default(uuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id])
  reassessmentId     String       @unique
  reassessment       Reassessment @relation(fields: [reassessmentId], references: [id])
  trajectorySnapshot Json
  summary            String
  wins               Json
  concerns           Json
  domainObservations Json?
  invalidatedAt      DateTime?
  createdAt          DateTime     @default(now())

  @@index([userId, createdAt])
}

model StudentDirective {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  content   String
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, active])
}

model StudentObservation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, active])
}

model CoachChatMessage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// 18/08: "link magico" pros e-mails de aquecimento de prospecto ("Continuar de onde parei") —
// mesmo padrao de seguranca do PasswordResetToken (token bruto so existe no e-mail, banco guarda
// so o hash; expira; uso unico). Nunca reaproveitado entre e-mails: cada envio gera um token novo.
model LoginLinkToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model UserNotification {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  title       String
  message     String
  type        String    @default("info")
  // Acao semantica interna que o app executa ao tocar na notificacao (ex: 'billing_regularize',
  // 'training_view'). Nunca uma URL externa — a URL real e resolvida autenticada via API no
  // momento do clique, garantindo que sempre aponta para o estado atual correto.
  action      String?
  // ID do evento externo que originou esta notificacao (ex: payment.id do Asaas). Usado como
  // chave primaria de deduplicacao: o mesmo evento nunca gera duas notificacoes, independente
  // de quantas vezes o webhook ou o cron reprocessar o mesmo aluno.
  externalRef String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
}

model MessageLog {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  channel           String
  trigger           String
  subject           String?
  content           String
  status            String    @default("sent")
  errorDetail       String?
  createdAt         DateTime  @default(now())
  // 27/08: id que a Resend devolve no envio — correlaciona esse registro com os eventos que
  // chegam depois pelo webhook (delivered/bounced/complained/opened). "status" acima so' reflete
  // se a Resend ACEITOU processar o envio, nao se realmente chegou na caixa de entrada — sem
  // isso, um e-mail "sent" podia ter simplesmente batido num endereco inexistente sem ninguem
  // nunca saber.
  resendEmailId     String?
  deliveryStatus    String?
  deliveryUpdatedAt DateTime?

  @@index([userId, createdAt])
  @@index([trigger, createdAt])
  @@index([resendEmailId])
}

model HealthProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  systolic          Int?
  diastolic         Int?
  diabetes          Boolean?
  previousSurgeries String?
  previousInjuries  String?
  healthProblems    String?
  medications       String?
  averageSleep      String?
  stressLevel       String?
  anxietyLevel      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model UserPreferences {
  id                  String    @id @default(uuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id])
  preferredModalities String[]
  otherModalities     String[]
  trainingLocations   String[]
  mainGoal            String
  targetRaceDate      DateTime?
  strengthAddOn       String?
  experienceLevel     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model WeeklyAvailability {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  weekday           Int
  noTraining        Boolean  @default(false)
  modalities        String[]
  availableMin      Int?
  modalityDurations Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, weekday])
}

model FitnessTest {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  testType         String   @default("3km")
  totalSeconds     Int
  avgHeartRate     Int?
  maxHeartRate     Int?
  environment      String
  vo2maxEstimated  Float
  vvo2Kmh          Float
  paceSecondsPerKm Int
  notes            String?
  createdAt        DateTime @default(now())
}

model TrainingPlan {
  id               String            @id @default(uuid())
  // Codigo sequencial de rastreio (pedido do treinador 16/08) — um numero de controle por
  // PRESCRICAO (cada geracao/regeneracao de semana cria um TrainingPlan novo, o anterior fica
  // arquivado), nao por aluno. Mesmo padrao de User.studentCode: sequence do banco, nunca
  // reaproveitado. Existe so pra permitir "aluna X relatou um problema no treino numero tal"
  // como referencia inequivoca em conversa/suporte — nao tem nenhum uso logico no sistema.
  planCode         Int               @unique @default(autoincrement())
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  name             String
  goal             String
  status           String            @default("active")
  version          Int               @default(1)
  startDate        DateTime
  endDate          DateTime?
  generatedBy      String            @default("mock")
  inputSnapshot    Json
  aiRecommendation String?
  createdAt        DateTime          @default(now())
  sessions         TrainingSession[]
  weeklyCheckIns   WeeklyCheckIn[]
}

// Trava de concorrencia no BANCO (29/09/2026, auditoria Astra item 02) — impede duas geracoes de
// treino do MESMO aluno rodando ao mesmo tempo, seja pela rota on-demand, pelo botao "Refazer" do
// treinador, ou por qualquer outro caminho que chame TrainingPlansService.generateWeek(). Substitui
// o Map em memoria antigo (currentWeekGenerationInFlight), que so protegia uma unica instancia do
// processo e um unico caminho de chamada. A unicidade de userId e' quem garante a exclusao mutua —
// tentar criar uma segunda linha pro mesmo userId falha com violacao de unique constraint (P2002),
// nunca corrida silenciosa. Uma trava "presa" (processo morreu no meio) e' liberada automaticamente
// por idade (ver GENERATION_LOCK_STALE_AFTER_MS em training-plans.service.ts) — nunca fica travada
// pra sempre.
model TrainingPlanGenerationLock {
  userId    String   @id
  startedAt DateTime @default(now())
}

model TrainingExecutionInsight {
  id        String   @id @default(uuid())
  userId    String
  planId    String   @unique
  summary   Json
  items     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model TrainingSession {
  id                  String             @id @default(uuid())
  planId              String
  plan                TrainingPlan       @relation(fields: [planId], references: [id])
  userId              String
  scheduledDate       DateTime
  weekday             Int
  modality            String
  title               String
  sessionType         String?
  locationSuggestion  String?
  durationMin         Int?
  distanceKm          Float?
  intensityZone       String?
  paceMinSec          String?
  structure           Json
  notes               String?
  recommendations     String?
  videoRefs           String[]
  // Preenchido quando esta sessao especifica saiu da rotina/tempo que o aluno combinou (dia a
  // mais, ou duracao diferente) sem nenhuma diretriz do gerente tecnico explicando o motivo —
  // mostrado pro aluno como aviso na tela do treino, pedindo pra ele contar no feedback se deu
  // pra realizar e como se sentiu. Null quando a sessao segue a rotina normalmente (a grande
  // maioria). Nao bloqueia nada, so marca — ver [[training_plans.service.ts generateWeek]].
  routineMismatchNote String?
  createdAt           DateTime           @default(now())
  // Correcao definitiva do ciclo de vida da prescricao (25/09/2026, Passo 2 fechado). Origem real
  // desta sessao — 'agent' (gerada/regenerada pelo prescription-agent), 'coach_manual' (treinador
  // criou direto, sem passar pelo agente), 'student_extra' (aluno registrou treino extra por conta
  // propria, manualmente) ou 'device_extra' (01/10/2026 — sessao sintetica criada automaticamente
  // a partir de um ActivityLog classificado como extra pelo SessionExecutionLinkService; mesma
  // ideia de 'student_extra', so' que a origem do dado e' um dispositivo/provedor em vez do
  // formulario manual). Nullable de proposito: registros criados ANTES desta coluna existir ficam
  // null (desconhecido) — nunca inventamos origem retroativa pra dado legado. Novas sessoes
  // sempre recebem um valor real nos pontos de criacao (generateWeek/regenerateSession,
  // createManualSession, addStudentExtraSession, SessionExecutionLinkService.materializeExtra).
  origin              String?
  // Quando um treinador edita manualmente (updateTrainingSession) uma sessao que JA tem
  // completion, guardamos aqui um snapshot append-only do que a prescricao era ANTES da edicao —
  // nunca sobrescrevemos silenciosamente a prescricao associada a uma execucao ja registrada (ver
  // secao 18 do fechamento do Passo 2). Array de objetos {editedAt, modality, durationMin,
  // distanceKm, paceMinSec, structure}. Null/vazio quando a sessao nunca foi editada apos ter
  // completion. NAO e' um sistema de auditoria generico — so' existe pra esse caso especifico.
  prescriptionHistory Json?
  updatedAt           DateTime           @updatedAt
  completion          WorkoutCompletion?

  // Fundacao Prescricao x Execucao (01/10/2026) — ver SessionExecutionLink. 0..N atividades
  // executadas (ActivityLog, qualquer provedor) podem corresponder a esta sessao.
  executionLinks SessionExecutionLink[]

  // Fundacao WorkoutDelivery (02/10/2026) — ver model abaixo. 0..N tentativas de entrega desta
  // prescricao pra qualquer provider (Polar, e futuramente Garmin/COROS/Apple), independente de
  // SessionExecutionLink/ActivityLog (entrega != execucao).
  deliveries WorkoutDelivery[]

  // 09/09 — indice para queries de evolucao do atleta (busca por usuario + ordem cronologica).
  // Sem isso a query principal de evolucao faz full-scan em TrainingSession inteira.
  @@index([userId, scheduledDate])
}

// Fundacao WorkoutDelivery (02/10/2026). Tentativa/estado de entrega de uma representacao
// CANONICA e exportavel de uma TrainingSession pra um provider externo (relogio/app de terceiro).
// NAO representa execucao — isso e' responsabilidade exclusiva de ActivityLog/SessionExecutionLink,
// que esta tabela nunca altera nem referencia. Uma entrega que falhou nao significa que o treino
// nao foi feito (o aluno pode ter corrido sem o treino estruturado no relogio); uma entrega que
// teve sucesso nao significa que o treino foi executado (o aluno pode ter ignorado o relogio).
//
// Por que nao existe uma tabela "Workout" canonica separada: TrainingSession.structure (parts[],
// ver SessionPartDecision em training-methodology.ts) JA e' a representacao estruturada e
// independente de fabricante da prescricao — reaproveitada aqui, nao duplicada. canonicalWorkout
// e um SNAPSHOT (append-only, nunca reescrito) do que foi efetivamente traduzido e enviado nesta
// tentativa especifica; existe separado de TrainingSession.structure porque a prescricao pode ser
// editada depois do envio (ver TrainingSession.prescriptionHistory) e o snapshot da entrega precisa
// continuar mostrando exatamente o que o provider recebeu naquele momento, nao o estado atual.
//
// Cada tentativa de entrega e' uma LINHA NOVA, nunca uma atualizacao que sobrescreve uma tentativa
// anterior — isso preserva o historico completo de tentativas (inclusive falhas) sem nenhuma
// delecao. O UNICO campo mutavel apos a criacao e' o proprio ciclo de vida desta mesma tentativa
// (status/externalWorkoutId/timestamps/errorMessage), nunca o de outra linha.
//
// provider e String (nao enum) deliberadamente — mesmo padrao de ActivityLog.provider/
// RawExternalActivity.provider, pra nao exigir migration a cada novo fabricante. Nenhuma logica
// especifica de Polar/Garmin/COROS/Apple existe neste model: o adapter de cada provider traduz
// o canonicalWorkout pro formato proprio ANTES de chamar o provider (provider adapter -> traduz
// modelo canonico; nunca o inverso). Nenhum envio real (Polar ou outro) e' implementado nesta
// fundacao.
model WorkoutDelivery {
  id String @id @default(uuid())

  trainingSessionId String
  trainingSession   TrainingSession @relation(fields: [trainingSessionId], references: [id])

  provider String // 'polar' | outros futuros — nunca travado em enum

  // Representacao canonica (agnostica de fabricante) do workout efetivamente traduzido/enviado
  // nesta tentativa — snapshot, nao referencia viva a TrainingSession.structure atual.
  canonicalWorkout Json

  // 'pending' | 'sent' | 'delivered_to_device' | 'failed' | 'canceled' — ciclo de vida desta
  // UNICA tentativa. 'sent' = envio aceito/processado no caminho do provider (nao garante que
  // chegou ao relogio). 'delivered_to_device' e' um estado SEPARADO e so' deve ser usado quando o
  // provider oferecer uma confirmacao real de entrega ao dispositivo — nunca inferido/assumido a
  // partir de 'sent'. Providers sem essa confirmacao simplesmente nunca atingem este estado (a
  // tentativa fica 'sent' indefinidamente, o que e' honesto: sabemos que foi aceito, nao sabemos
  // se chegou). 'canceled' e' uma tentativa retirada deliberadamente (ex.: prescricao mudou antes
  // do provider processar) — distinto de 'failed' (erro) e nunca sobrescreve um status terminal
  // anterior.
  status String

  // Nullable de proposito: nao existe ate o provider confirmar, e nem todo provider/cenario de
  // falha chega a gerar um. Nunca assumir round-trip (nao ha garantia de conseguir reconsultar
  // este id de volta no provider).
  externalWorkoutId String?

  requestedAt DateTime  @default(now())
  sentAt      DateTime?
  // Preenchido SO quando o provider confirma recebimento real no dispositivo — nunca copiado de
  // sentAt nem preenchido por suposicao.
  deliveredAt DateTime?
  failedAt    DateTime?
  errorMessage String?
  // Cancelamento deliberado desta tentativa (nao e' falha nem sucesso).
  canceledAt  DateTime?

  // Metadata especifica do adapter/provider (ex.: endpoint usado, id de transaction da Polar) —
  // isolada aqui de proposito, nunca promovida a coluna canonica do model.
  providerMetadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trainingSessionId])
  @@index([provider, status])
}

model WorkoutCompletion {
  id                     String           @id @default(uuid())
  userId                 String
  user                   User             @relation(fields: [userId], references: [id])
  sessionId              String?          @unique
  session                TrainingSession? @relation(fields: [sessionId], references: [id])
  completedAt            DateTime         @default(now())
  status                 String
  durationMin            Float?
  distanceKm             Float?
  avgPaceSecondsKm       Int?
  avgHeartRate           Int?
  maxHeartRate           Int?
  perceivedEffort        Int?
  // "satisfaction" (original, 07/2026) passou a representar especificamente a satisfacao em FAZER
  // o treino (dimensao 2 de 4) — mantido sem renomear pra preservar historico. As outras 3
  // dimensoes (19/08, pedido do treinador: pergunta vaga = aluno perdido, igual comando vago pra
  // IA) sao colunas novas. Todas usam a mesma escala de 5 categorias (amei..detestei), exceto
  // satisfactionCarga que usa uma escala propria de adequacao (muito_leve..muito_pesada) — ver
  // SATISFACTION_SCORE/CARGA_SCORE em workout-completions.service.ts pra conversao numerica.
  satisfaction           String? // dimensao 2 historica: satisfacao em FAZER o treino — coletada ate 10/09/2026; substituida por postWorkoutFeeling
  satisfactionElaboracao String? // dimensao 1: satisfacao com a ELABORACAO do treino (v1: obrigatoria a partir de 11/09)
  satisfactionCapacidade String? // dimensao 3: satisfacao com COMO CONSEGUIU fazer (v1: obrigatoria a partir de 11/09)
  satisfactionCarga      String? // dimensao 4 historica: carga adequada? — coletada ate 10/09/2026; nao mais coletada na v1

  painFlag String? // none | leve | moderado | forte ('moderado' adicionado na v1)

  // Feedback v1 (11/09/2026) — bloco 1: estado pre-treino
  // 1=extremo negativo, 5=extremo positivo (ver labels em App.tsx/prescription-agent para cada variavel)
  preSleepQuality    Int? // 1=muito ruim, 5=excelente
  prePhysicalFatigue Int? // 1=muito baixo, 5=muito alto (cansaco fisico)
  preStressLevel     Int? // 1=muito baixo, 5=muito alto (estresse)
  preMotivation      Int? // 1=muito baixa, 5=muito alta

  // Feedback v1 (11/09/2026) — bloco 2: experiencia da sessao
  postWorkoutFeeling Int? // 1=muito mal, 5=muito bem (sensacao imediatamente apos terminar)

  // Feedback v1 (11/09/2026) — bloco 3: dor
  painTiming String? // condicional (so preenchido quando painFlag != 'none'):
  // ja_comecei_sentindo | comeco_passou | comeco_continuou |
  // durante_passou | durante_continuou | so_depois

  // Feedback v2 (24/09/2026) — reestruturacao do feedback individual do treino, pedido explicito
  // do treinador. REGRA CANONICA DAS ESCALAS 1-5 a partir daqui (e retroativamente documentada
  // pras que ja existiam): 5 = MAIOR intensidade/quantidade/presenca da variavel perguntada.
  // NUNCA inverter pra "5 = sempre bom" — cansaco 5 = muito cansado, estresse 5 = muito estressado,
  // sono 5 = excelente (aqui sim "bom" e' a propria intensidade perguntada). Isso e' proposital:
  // nos graficos futuros a altura da linha representa "quanto daquela variavel existe", nao uma
  // escala universal de bom/ruim. Ver GLOSSARIO_METRICAS.md e memoria feedback_v2_scale_convention.

  // Bloco SONO (5 variaveis, cada uma preservada individualmente — nunca so' um score agregado).
  // preSleepQuality (acima) e' a pergunta 1 (qualidade), mantida sem mudanca de coluna/semantica.
  // sleepDurationCategory: pergunta 2 — CATEGORICA, nao e' escala de intensidade 1-5 e nunca deve
  // ser interpretada como "quanto maior, melhor" (dormir demais nao e' "melhor" que a faixa ideal).
  // Valores: menos_5h | 5_a_6h | 6_a_7h | 7_a_8h | 8_a_9h | mais_9h.
  sleepDurationCategory      String?
  // Representacao numerica auxiliar da categoria acima (ponto medio da faixa em horas, ex: "6_a_7h"
  // -> 6.5), gravada so' pra facilitar calculo futuro — NAO e' uma escala de intensidade, e' so' a
  // transcricao numerica direta da categoria escolhida (sem formula, sem interpretacao).
  sleepDurationHoursEstimate Float?
  // Pergunta 3 (01/10/2026: SUBSTITUIDA por bedtimeShiftDirection em NightlySleepLog — perdia a
  // direcao do desvio, so' media "o quanto mudou"). Coluna preservada SO para historico; nunca mais
  // escrita a partir desta data. Sessoes antigas continuam legiveis por aqui.
  sleepScheduleIrregularity  Int?
  // Pergunta 4 — o quanto o sono foi interrompido durante a noite. 5 = mais interrompido.
  sleepInterruption          Int?
  // Pergunta 5 — dificuldade para pegar no sono. 5 = mais dificuldade.
  sleepDifficulty            Int?

  // 01/10/2026: a partir desta data, sono (perguntas 1-5 + as novas de horario de dormir/acordar)
  // passa a pertencer a UMA NOITE por aluno, nao a uma sessao — reutilizada entre todas as sessoes
  // daquele dia (ver NightlySleepLog). As colunas preSleepQuality/sleepDurationCategory/
  // sleepInterruption/sleepDifficulty ACIMA continuam sendo gravadas em todo completion novo (copia
  // desnormalizada do valor da noite, mantem Admin/Telegram/prontuario funcionando sem alteracao) —
  // mas a Training Intelligence (ver observation-reader.service.ts) passou a ler sono EXCLUSIVAMENTE
  // de NightlySleepLog quando nightlySleepLogId estiver preenchido, nunca das colunas acima, pra nao
  // contar a mesma noite duas vezes quando ha mais de uma sessao no dia. Completions anteriores a
  // esta data (nightlySleepLogId null) continuam lidos pelas colunas, exatamente como sempre foram —
  // nao ha reinterpretacao retroativa do historico.
  nightlySleepLog   NightlySleepLog? @relation(fields: [nightlySleepLogId], references: [id])
  nightlySleepLogId String?

  // 01/10/2026: estresse (pergunta 8 + a nova de frequencia) passa a ter timestamp real proprio e
  // pode ser reaproveitado/atualizado dentro de uma janela movel de 24h entre sessoes, em vez de
  // ser reperguntado sem necessidade — NAO e' "uma noite" (ver StressCheckin), e' uma janela movel
  // ancorada no instante real da resposta. preStressLevel acima continua gravado por completion
  // (mesma logica de copia desnormalizada acima); a TI le de StressCheckin quando presente.
  stressCheckin   StressCheckin? @relation(fields: [stressCheckinId], references: [id])
  stressCheckinId String?

  // Bloco ESTADO ANTES DO TREINO. prePhysicalFatigue (acima) = pergunta 6, mantida sem mudanca.
  // preStressLevel (acima) = pergunta 8: ADAPTADA a partir do feedbackVersion 2 — deixou de medir
  // "no instante antes de comecar" e passou a medir "no ultimo dia" (mesma coluna, janela temporal
  // diferente; direcao inalterada, 5 = mais estresse). preMotivation (acima) = pergunta 9: ADAPTADA,
  // redacao mais concreta ("vontade de fazer o treino de hoje"), mesma coluna e direcao (5 = mais
  // vontade) — conceitualmente e' a mesma variavel de motivacao que ja existia.
  // Pergunta 7, NOVA — cansaco mental antes de comecar. 5 = mais cansaco mental.
  preMentalFatigue Int?

  // Bloco RESPOSTA AO TREINO. perceivedEffort (RPE, acima) = pergunta 10, mantido (escala 1-10,
  // nunca convertida pra 1-5). satisfactionElaboracao (acima) = pergunta 11, mantido (mesma coluna
  // e mesma escala amei..detestei ja convertida 1-5 via SATISFACTION_SCORE) — so' o rotulo exibido
  // ao aluno muda pra "Pessima..Excelente".
  //
  // Pergunta 12 (feedbackVersion 2), SUBSTITUIDA em 01/10/2026 por executionBehavior abaixo —
  // CONGELADA, preservada so para historico, nunca mais escrita. Media/baseline/tendencia sobre
  // este campo continuam validas SO para registros desta epoca (ver versionComparability em
  // variable-registry.ts) — era mesmo uma escala ordinal quantitativa (1=fiz bem menos..5=bem
  // mais), diferente da nova pergunta (comportamental/categorica, ver executionBehavior).
  executionVsPrescribed Int?

  // Pergunta 12 (feedbackVersion 3, 01/10/2026) — SUBSTITUI executionVsPrescribed. Mede o
  // COMPORTAMENTO do aluno diante da prescricao (nao distancia/duracao/intensidade/ritmo/volume —
  // isso fica a cargo do dado objetivo de execucao, incl. integracoes de relogio). Categorica, NAO
  // ordinal — nunca calcular media/baseline/tendencia nem interpretar uma categoria como "mais"
  // que outra. Valores: as_planned | minor_adaptations | major_changes | different_workout |
  // stopped_early. "Nao fiz o treino" nao e uma destas categorias — tem fluxo proprio (status
  // 'missed'); esta pergunta so se aplica quando houve inicio/execucao real do treino.
  executionBehavior String?

  // Pergunta 13, SUBSTITUI postWorkoutFeeling pra sessoes feedbackVersion>=2 — NAO reaproveita a
  // coluna antiga porque a direcao da escala e' OPOSTA: postWorkoutFeeling era 1=muito mal,
  // 5=muito bem (positivo=bom); a pergunta nova mede cansaco fisico provocado pelo treino,
  // 1=muito pouco, 5=extremamente (positivo=mais cansaco). Reaproveitar a mesma coluna teria
  // corrompido silenciosamente qualquer media historica misturando v1 e v2. postWorkoutFeeling
  // continua existindo e sendo lida em sessoes feedbackVersion 1.
  postPhysicalFatigue       Int?
  // Pergunta 14, NOVA — cansaco mental provocado pelo treino. 5 = mais cansaco mental.
  postMentalFatigue         Int?
  // Pergunta 15, SUBSTITUI o campo "postWorkoutMood" que vivia em details (JSON, sem coluna
  // propria, 12/09/2026) — promovido a coluna real. Experiencia emocional DURANTE o treino.
  // 1=muito mal, 5=muito bem. Leitura de sessoes antigas (feedbackVersion 1) deve continuar
  // buscando o valor em details.postWorkoutMood — nunca reescrito, so' lido de outro lugar.
  emotionalExperienceDuring Int?
  // Pergunta 16, NOVA — mudanca percebida no estado mental comparando antes x depois do treino.
  // Nao e' redundante com a 15 (que mede a experiencia DURANTE, nao a mudanca). 1=muito pior,
  // 5=muito melhor (aqui "melhor" e' o proprio sentido da pergunta, nao inversao de intensidade).
  mentalStateChangePrePost  Int?

  // Versionamento: incrementar so quando o significado de uma variavel mudar de verdade.
  // v1 = estrutura de 11/09/2026 (blocos 1-2-3, 8 perguntas obrigatorias + dor).
  // v2 = estrutura de 24/09/2026 (16 perguntas, blocos Sono/Estado antes/Resposta ao treino) —
  // ver tabela mantida/adaptada/substituida/nova completa em GLOSSARIO_METRICAS.md.
  feedbackVersion Int @default(1)

  notes   String?
  details Json?
  source  String  @default("manual")

  // Correcao definitiva do ciclo de vida da prescricao (25/09/2026) — "Fiz, mas mudei o treino"
  // (status continua sendo o valor legado 'adjusted', so o ROTULO exibido mudou, sem migration
  // destrutiva). Motivos de multipla escolha (ids curtos, ver ADJUSTMENT_REASON_OPTIONS no
  // mobile), so' preenchido quando status='adjusted'. NAO altera TrainingSession — a prescricao
  // original permanece intacta; isso so' descreve o PORQUE da execucao ter sido diferente.
  adjustmentReasons           String[]
  adjustmentComment           String?
  // So' preenchido quando um dos adjustmentReasons for "preferi fazer outro treino".
  adjustmentPreferredActivity String?

  // 25/09/2026 (Passo 4 — contexto longitudinal): quando esta e' a PRIMEIRA execucao valida
  // registrada depois de um retorno-apos-lacuna (ver ContextEvent), fica marcada aqui — metadado
  // puro, nao altera nenhum campo semantico existente de WorkoutCompletion. Preenchido por
  // ContextEventsService.linkFirstObservationIfPending, nunca pelo proprio fluxo de salvar feedback.
  firstObservationAfterGapEvent   ContextEvent? @relation(fields: [firstObservationAfterGapEventId], references: [id])
  firstObservationAfterGapEventId String?

  // Meus Tenis (04/10/2026) — ver ShoeUsage.
  shoeUsage ShoeUsage?

  @@index([firstObservationAfterGapEventId])
}

// 01/10/2026 — uma noite de sono por aluno, reutilizada por todas as sessoes/completions daquele
// dia (ver comentario em WorkoutCompletion.nightlySleepLogId). "nightDate" usa a MESMA convencao de
// TrainingSession.scheduledDate (meia-noite UTC representando o dia a que o dado se refere, imune a
// fuso horario) — nao e' um timestamp de quando a resposta foi enviada. Ausencia de dado em
// qualquer campo e' null, nunca zero/categoria default. Nao existe score de sono aqui, so' as
// variaveis individuais preservadas (mesmo principio do WorkoutCompletion original).
model NightlySleepLog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  nightDate DateTime

  // Pergunta 1 — qualidade percebida do sono. Mantida sem mudanca de escala/direcao (5=excelente).
  sleepQuality               Int?
  // Pergunta 2 — categorica, nao e' escala de intensidade. Valores: menos_5h|5_a_6h|6_a_7h|7_a_8h|8_a_9h|mais_9h.
  sleepDurationCategory      String?
  // Transcricao numerica direta da categoria (ponto medio da faixa) — mesma funcao
  // sleepDurationHoursEstimate() de workout-completions.service.ts, sem formula nova.
  sleepDurationHoursEstimate Float?
  // Pergunta 3 NOVA (substitui sleepScheduleIrregularity) — direcao + magnitude do horario de
  // DORMIR em relacao ao habitual. Categorica por design (nunca forcar numa escala 1-5 artificial):
  // much_earlier | moderately_earlier | slightly_earlier | on_time | slightly_later |
  // moderately_later | much_later.
  bedtimeShiftDirection      String?
  // Pergunta NOVA — mesma logica/categorias acima, para o horario de ACORDAR.
  wakeTimeShiftDirection     String?
  // Pergunta 4 — sono interrompido durante a noite. Mantida (5=mais interrompido).
  sleepInterruption          Int?
  // Pergunta 5 — dificuldade para pegar no sono. Mantida (5=mais dificuldade).
  sleepDifficulty            Int?

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  completions WorkoutCompletion[]

  @@unique([userId, nightDate])
}

// 01/10/2026 — estresse das ultimas 24h. Timestamp REAL da resposta (respondedAt), NUNCA um dia de
// calendario — "ultimas 24h" e' uma janela movel ancorada nesse instante, conceitualmente diferente
// de NightlySleepLog (que representa uma noite fixa). Uma resposta recente (dentro de 24h) pode ser
// atualizada no lugar (mesma linha, mesmo respondedAt original) em vez de criar uma observacao nova
// — ver resolveStressCheckin() em workout-completions.service.ts. Sem score de estresse.
model StressCheckin {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  respondedAt DateTime @default(now())

  // "Nas ultimas 24 horas, qual foi o seu nivel geral de estresse?" 1=muito baixo, 5=muito alto.
  stressLevel          Int?
  // NOVA — "Nas ultimas 24 horas, com que frequencia voce passou por momentos que aumentaram
  // claramente seu estresse?" 1=nenhuma vez, 5=quase continuamente.
  stressEventFrequency Int?

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  completions WorkoutCompletion[]

  @@index([userId, respondedAt])
}

// 25/09/2026 (Passo 4) — representacao estruturada de eventos de contexto externos a trajetoria de
// treino (trabalho, viagem, familia, saude, dor/lesao, sono, mudanca de rotina) e, como primeira
// aplicacao concreta, do questionario de RETORNO APOS LACUNA (ver GAP_RETURN_THRESHOLD_DAYS em
// context-event-types.ts). Especificacao alinhada a ATHLETE_STATE_MODEL.md secoes 12-15 (ja escrita
// por Elton antes desta implementacao): guarda o RELATO estruturado, nunca a causa inferida.
model ContextEvent {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // work | routine_change | travel | family_personal | health | illness | pain_injury | sleep | other
  type    String
  subtype String?

  // Intervalo do evento em si (ex: data de inicio da viagem/afastamento). endedAt null = evento
  // ainda ativo (nunca forcamos uma data final quando ela nao existe). Para eventos de retorno-
  // apos-lacuna, startedAt/endedAt descrevem a LACUNA (dia seguinte a ultima execucao valida ate a
  // data do relato de retorno) — ver gapAnchorDate abaixo pra' o ponto exato de deduplicacao.
  startedAt  DateTime?
  endedAt    DateTime?
  reportedAt DateTime  @default(now())
  // ongoing | ended
  status     String    @default("ongoing")

  // student_reported | coach_reported | reassessment | return_after_gap | system_detected
  // (system_detected reservado para deteccao futura de mudanca-sem-causa-conhecida — nao escrito
  // por nenhum codigo desta implementacao, ver secao 30 do Passo 4).
  source String

  // Texto original do relato (aluno/treinador) — nunca perdido, mesmo quando type/subtype
  // estruturam a mesma informacao. Ver ATHLETE_STATE_MODEL.md secao 13.
  originalText String?

  // Campos exclusivos do questionario de RETORNO APOS LACUNA (source='student_reported' com
  // gapAnchorDate preenchido). Null para ContextEvent manual/generico. Nao vira uma tabela
  // separada de proposito (secao 13 do Passo 4: "evite estruturas duplicadas").
  // Ancora de deduplicacao: a data da ultima execucao valida ANTES da lacuna que gerou este evento
  // — impede perguntar de novo pela mesma lacuna (ver ContextEventsService.getReturnQuestionnaireState).
  gapAnchorDate                   DateTime?
  // none | very_little | some_outside | normal_outside (ver TRAINING_DURING_GAP_OPTIONS)
  trainingDuringGapReported       String?
  // 1 (muito pior) a 5 (muito melhor), autorrelato, nunca calculado
  physicalStateComparedToBefore   Int?
  // 1 (muito menor) a 5 (muito maior), autorrelato, nunca calculado
  mentalReadinessComparedToBefore Int?
  // true assim que uma WorkoutCompletion real for vinculada como "primeira observacao apos a
  // lacuna" (ver WorkoutCompletion.firstObservationAfterGapEventId) — evita vincular mais de uma.
  firstObservationLinkedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firstObservationCompletions WorkoutCompletion[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([userId, gapAnchorDate])
}

model TargetRace {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  name          String
  raceDate      DateTime
  distanceKm    Float
  targetSeconds Int?
  priority      String   @default("principal")
  status        String   @default("em_andamento")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Questionario de contexto sobre a meta (pedido explicito do treinador, 10/08) — escala de 1 a
  // 10, tudo opcional (provas cadastradas antes disso ficam sem essas respostas ate serem
  // editadas). Existe pra IA calibrar TOM e o quanto vale empurrar alem do confortavel, nunca
  // como formula/trava — ver a regra correspondente em prescription-agent.service.ts.
  performanceIntent       Int?
  socialIntent            Int?
  personalImportance      Int?
  perceivedDifficulty     Int?
  dedicationWillingness   Int?
  achievementSatisfaction Int?
  confidenceLevel         Int?
  injuryConcern           Int?
  adjustmentOpenness      Int?
  anxietyLevel            Int?
  isFirstTimeAtDistance   Boolean?

  @@index([userId, status])
}

model PainReport {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  regions            String[]
  regionDetails      Json?
  otherLocation      String?
  intensity          Int
  onsetPattern       String
  persistencePattern String
  // Adicionados 18/08 — "investigador de dor guiado" (ideia do proprio treinador, ver
  // panzeri_methodology): a dor esta piorando/estavel/melhorando ao longo dos treinos, e
  // atrapalha o dia a dia fora do treino. Nullable pra nao quebrar relatos antigos.
  worseningTrend     String?
  dailyLifeImpact    String?
  previousPainStatus String?
  resolvedRegions    String[]
  comment            String?
  createdAt          DateTime @default(now())

  @@index([userId, createdAt])
}

// 31/08: check-in obrigatorio antes de gerar a proxima semana (pedido do treinador) — junta duas
// coisas: (a) confirmacao de que o aluno registrou tudo que fez/nao fez na semana que esta
// terminando, com os numeros reais (previsto/mudou modalidade/diferente/sem registro) capturados
// no momento, e (b) respostas em escala sobre a semana como um todo (nao por sessao — ja existe
// avaliacao por sessao em WorkoutCompletion). Guardado em tabela propria, com numero (nao texto
// livre), de proposito: o treinador quer poder analisar padrao de adesao/engajamento/risco de
// abandono ou lesao no medio prazo, o que exige dado limpo e consultavel, nao um resumo em prosa.
// 11/09: expandido de 3 para 15 perguntas em 3 blocos (checkinVersion=2). As 3 colunas
// originais ficam nullable para nao quebrar registros antigos (v1). Sentinel de "pulou" em v1:
// elaborationSatisfaction===0; em v2: checkinSkipped=true. A IA recebe semDados em ambos os casos.
model WeeklyCheckIn {
  id                          String        @id @default(uuid())
  userId                      String
  user                        User          @relation(fields: [userId], references: [id])
  planId                      String?
  plan                        TrainingPlan? @relation(fields: [planId], references: [id])
  weekStartDate               DateTime
  // Numeros reais da semana, capturados no momento do check-in (nao recalculados depois) — mesma
  // fonte que StravaService.report() ja usa pra montar o relatorio de evolucao, reaproveitados
  // aqui em vez de duplicar a logica de comparacao previsto/feito.
  asPrescribedSessions        Int
  changedModalitySessions     Int
  differentSessions           Int
  missedSessions              Int
  // V1 (3 perguntas, 31/08). Nullable a partir de 11/09 para compat com v2.
  // elaborationSatisfaction===0 era o sentinel de "pulou" no v1 — preservado para leitura.
  elaborationSatisfaction     Int?
  adherenceSatisfaction       Int?
  // nextWeekMotivation compartilhado entre v1 (pergunta 3) e v2 (pergunta 11, bloco 3).
  nextWeekMotivation          Int?
  // V2 Bloco 1: Como foi sua semana (11/09)
  prescriptionLiking          Int?
  prescriptionSuitability     Int?
  perceivedExecution          Int?
  executionSatisfaction       Int?
  postWeekMotivation          Int?
  // V2 Bloco 2: Como voce esta
  weeklySleep                 Int?
  currentPhysicalFatigue      Int?
  weeklyStress                Int?
  routineInterference         Int?
  bodyResponseVsNormal        Int?
  // V2 Bloco 3: Proxima semana (nextWeekMotivation acima + os 4 abaixo + preferencia textual)
  nextWeekConfidence          Int?
  expectedScheduleFeasibility Int?
  expectedPhysicalState       Int?
  // preferredNextWeekTraining: reaproveitada pela v3 (24/09/2026) com um universo de valores NOVO
  // e disjunto do antigo (10 opcoes v2 -> 5 opcoes v3) — checkinVersion diz qual conjunto vale pra
  // aquela linha. Nunca colidem: nenhum id v3 repete um id v2 (ver PREFERRED_TRAINING_OPTIONS_V3
  // no mobile e a lista correspondente em weekly-checkin.service.ts).
  preferredNextWeekTraining   String?

  // V3 (24/09/2026) — check-in semanal reduzido a 9 perguntas: o feedback de cada sessao
  // individual (feedbackVersion v2) agora ja cobre sono/cansaco fisico/cansaco mental/estresse/
  // vontade de treinar/RPE por treino, entao o semanal deixou de repetir isso e passou a focar em
  // percepcao AGREGADA da semana + expectativa pra proxima. MESMA REGRA CANONICA das escalas do
  // feedback individual: 5 = maior intensidade/quantidade da variavel perguntada, nunca invertida
  // pra "5 = sempre bom".
  //
  // Pergunta 4 (bloco 1): exigencia da semana comparada ao normal do proprio aluno. 5 = muito mais
  // exigente. Variavel nova, sem equivalente anterior — futuramente cruzada com carga
  // prescrita/executada, volume, RPE das sessoes e baseline individual.
  weekDemandVsNormal          Int?
  // Pergunta 7 (bloco 3): interferencia ESPERADA da rotina/compromissos na PROXIMA semana
  // (prospectivo). 5 = interferencia muito alta. NAO e' a mesma variavel de routineInterference
  // (acima, v2) nem de expectedScheduleFeasibility (acima, v2) — routineInterference era
  // retrospectivo (olhava pra semana que passou) e tinha a escala invertida (5=nao atrapalhou);
  // expectedScheduleFeasibility perguntava sobre espaco na agenda com escala tambem invertida
  // (5=semana livre). Reaproveitar qualquer uma delas teria misturado silenciosamente semanticas e
  // direcoes de escala diferentes — por isso e' coluna nova.
  expectedRoutineInterference Int?
  // Pergunta 9 (bloco 4): observacao livre e opcional sobre a semana ou a proxima. Substitui
  // qualquer necessidade de inferir isso das perguntas estruturadas.
  freeTextObservation         String?

  // Meta: versao do formulario (1=3 perguntas, 2=15 perguntas, 3=9 perguntas) e flag de skip
  // explicito. Ver tabela completa mantida/adaptada/substituida/retirada/nova em
  // GLOSSARIO_METRICAS.md.
  checkinVersion Int      @default(1)
  checkinSkipped Boolean  @default(false)
  createdAt      DateTime @default(now())

  // Trava a mesma garantia de "um check-in por plano" que o codigo (WeeklyCheckInService.submit)
  // ja tentava manter so' com um findFirst antes do create — achado por auto-revisao: sem isso no
  // banco, duas chamadas quase simultaneas (duplo toque, dois aparelhos) podiam criar duas linhas
  // pro mesmo plano.
  @@unique([userId, planId])
  @@index([userId, createdAt])
}

// 11/09: rastreamento de ciclo menstrual para correlacao com aderencia/dor/desempenho.
// Finalidade: correlacao estatistica (ex: "na fase 1 a aderencia cai X%") — nao diagnostico.
// O agente de treino recebe o contexto como dado geral, nao como regra de prescricao.
// A futura camada de analise de padroes (agente de evolucao) cruzara esses dados com o historico.
model MenstrualProfile {
  id                        String   @id @default(uuid())
  userId                    String   @unique
  user                      User     @relation(fields: [userId], references: [id])
  // Ciclo ativo: true = sim, false = nao/menopausa, null = preferiu nao informar
  hasActiveCycle            Boolean?
  // Uso de anticoncepcional hormonal (null = preferiu nao informar)
  usesHormonalContraceptive Boolean?
  // Tipo quando usa anticoncepcional — identificador semantico (ex: 'pilula_combinada', 'diu_hormonal')
  contraceptiveType         String?
  // Duracao tipica do ciclo (dias do 1o ao proximo 1o dia) — null quando usa hormonal ou nao informou.
  // A partir de 25/09/2026 e' so' o valor DECLARADO pela aluna na configuracao inicial (chute dela);
  // a duracao REAL observada vem de MenstrualCycleService.getCycleOverview(), derivada
  // deterministicamente do historico de MenstrualCycleLog via MathLayer/LongitudinalDynamics —
  // nunca assumindo 28 dias fixos. AVISO: quando usesHormonalContraceptive=true as fases estimadas NAO sao confiaveis
  cycleLengthDays           Int?
  // Duracao tipica da menstruacao — null quando usa hormonal ou nao informou (mesma ressalva acima)
  periodLengthDays          Int?
  // 25/09/2026 (evolucao do acompanhamento menstrual) — campos opcionais adicionais da configuracao
  // inicial. Todos null = "preferiu nao informar", igual ao padrao ja estabelecido acima.
  cycleRegularity           String? // 'regular' | 'irregular' | 'unknown'
  diuType                   String? // 'none' | 'hormonal' | 'non_hormonal'
  menopauseStatus           String? // 'none' | 'perimenopause' | 'menopause'
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

// Um registro por ciclo — agora com inicio E fim (25/09/2026), pra preservar duracao real do
// sangramento e do ciclo. cycleEndDate null = sangramento em curso ou nao informado ainda.
// Sintomas do dia 1 continuam aqui por compatibilidade; sintomas DIARIOS (qualquer dia, nao so o
// dia 1) vivem em MenstrualDailyLog, uma tabela nova e separada — sao conceitos diferentes (evento
// de fronteira do ciclo vs. observacao do dia).
model MenstrualCycleLog {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  // Data do 1o dia — armazenado como DateTime mas representa so a data (horario zerado)
  cycleStartDate DateTime
  // 25/09/2026 — data do ultimo dia do sangramento (mesma convencao: hora zerada). Null = ainda em
  // curso ou nao informado. Permite calcular duracao real do sangramento por ciclo.
  cycleEndDate   DateTime?
  // Sintomas no dia 1 (escala 1–5, opcionais — a aluna pode registrar so a data)
  crampsLevel    Int? // 1=sem cólicas, 5=muito intensa
  energyLevel    Int? // 1=muito baixa, 5=alta
  moodLevel      Int? // 1=muito instavel, 5=muito estavel
  // 25/09/2026 — intensidade do fluxo no dia 1 (opcional). Categorico, nunca virou escala numerica
  // artificial (mesma regra de "categoria nao vira escala continua" do restante do Registry).
  flowIntensity  String? // 'leve' | 'moderado' | 'intenso'
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, cycleStartDate])
}

// 25/09/2026 (evolucao do acompanhamento menstrual) — UM registro por dia (upsert por data), pra
// sintomas poderem ser acompanhados em qualquer dia do ciclo, nao so no dia 1. Fonte canonica que
// alimenta ObservationReaderService (novo VariableSource 'student_menstrual_daily_log') — mesma
// arquitetura de Observation ja usada por WorkoutCompletion/WeeklyCheckIn, nao uma segunda.
model MenstrualDailyLog {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  date          DateTime // dia (hora zerada)
  crampsLevel   Int?
  energyLevel   Int?
  moodLevel     Int?
  flowIntensity String? // 'leve' | 'moderado' | 'intenso' | null (fora do sangramento ou nao informado)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model StravaConnection {
  id           String   @id @default(uuid())
  userId       String   @unique
  athleteId    String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Tentativa OAuth de uso unico; o state nunca e persistido em texto puro.
model PolarOAuthAttempt {
  stateHash  String    @id
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Credencial de conexao + estado da ingestao Polar AccessLink (30/09-01/10/2026).
// OAuth concluido (esta linha existir) e usuario registrado no AccessLink (registeredAt) sao
// dois estados DIFERENTES: a AccessLink exige um POST /v3/users explicito apos o OAuth antes de
// aceitar qualquer leitura de exercicio — sem isso, exercise-transactions falha mesmo com token
// valido. registeredAt null = ainda nao registrado (proximo sync deve registrar antes de abrir
// transaction); 409 do registro (membro ja registrado) tambem seta registeredAt, e' idempotente.
// openTransactionId/openTransactionOpenedAt existem para retomada segura: a Polar so permite UMA
// exercise-transaction aberta por vez (abrir outra sem commitar da 409). Se um sync cair no meio
// (ex.: 3 de 5 exercicios persistidos e falhou), o proximo sync REUTILIZA a mesma transaction em
// vez de abrir outra — ver PolarActivityIngestionService.sync(). So commitamos na Polar depois que
// TODOS os exercicios da transaction foram persistidos localmente com sucesso (raw + ActivityLog).
// Estado da conexao (04/10/2026): disconnectedAt == null => coleta autorizada; preenchido =>
// desconectada/revogada pelo aluno (accessTokenEncrypted vira null; polarUserId e' mantido para o
// webhook identificar e DESCARTAR eventos tardios). Reconectar limpa disconnectedAt via nova autorizacao.
model PolarConnection {
  id                      String    @id @default(uuid())
  userId                  String    @unique
  polarUserId             String    @unique
  accessTokenEncrypted    String?
  disconnectedAt          DateTime?
  registeredAt            DateTime?
  openTransactionId       String?
  openTransactionOpenedAt DateTime?
  lastSyncCompletedAt     DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

// Trilha de auditoria de provedores (04/10/2026): desconexao, exclusao de dados e leitura admin do payload
// bruto (05/10/2026), generica por provedor. Sem FK em userId de proposito: o registro de que a exclusao ocorreu sobrevive a exclusao
// da conta. "details" guarda so' contagens/resultado — nunca token, payload ou dado esportivo.
model ProviderConnectionEvent {
  id        String   @id @default(uuid())
  userId    String
  provider  String
  type      String // 'disconnected' | 'data_deleted' | 'raw_read' (leitura admin do payload bruto; userId = aluno dono)
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId, provider])
}

// Webhook de notificacao do provedor Polar (03/10/2026). Uma assinatura por aplicacao (nao por
// aluno): a Polar devolve signature_secret_key UMA vez, na criacao — guardamos cifrado (mesma
// chave de POLAR_TOKEN_ENCRYPTION_KEY dos tokens) pra verificar HMAC-SHA256 de cada evento
// recebido. polarWebhookId vem da resposta de criacao (null enquanto nao registrado).
model PolarWebhookSubscription {
  id                      String    @id @default(uuid())
  url                     String
  polarWebhookId          String?
  signatureSecretEncrypted String
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

// Registro externo preservado tal como recebido do provedor, antes de qualquer normalizacao.
// Generico por design: "provider" e "externalId" identificam a fonte (hoje so 'polar' grava aqui;
// Strava continua em StravaActivity, sem migracao nesta etapa — ver ActivityLog abaixo para o
// motivo). "payload" e o corpo bruto retornado pelo provedor, sem nenhum campo descartado —
// mesmo o que ainda nao sabemos usar fica preservado aqui para reprocessamento futuro.
// "ingestionMeta" guarda contexto DA NOSSA ingestao (ex.: id da transaction Polar, endpoint
// exato, timestamp da chamada) — deliberadamente fora de "payload" para nao misturar o que o
// provedor mandou com o que nos registramos sobre a coleta.
//
// Unicidade: o dedup e por (provider, userId, externalId), nao so (provider, externalId).
// Motivo (DESCONHECIDO explicito, nao GARANTIDO pela documentacao publica da Polar): nao foi
// possivel confirmar com certeza se o "id" de exercicio da AccessLink e globalmente unico entre
// TODAS as contas Polar ou apenas unico dentro da conta do proprio usuario. Incluir userId na
// chave e correto nos dois cenarios (se for global, userId fica redundante mas inofensivo; se for
// só por conta, userId e o que evita colisao entre duas alunas diferentes). Reavaliar se a Polar
// confirmar formalmente unicidade global.
model RawExternalActivity {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id])
  provider             String
  externalId           String
  payload              Json
  payloadSchemaVersion String?
  ingestionMeta        Json?
  sourceUpdatedAt      DateTime?
  receivedAt           DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  activityLog ActivityLog?

  @@unique([provider, userId, externalId])
  @@index([userId])
}

// Atividade fisica observada, representacao CANONICA e agnostica de provedor — nao deve conter
// nenhum conceito nomeado 'polar*' nem depender semanticamente do formato da AccessLink. Motivo:
// evitar repetir o padrao StravaActivity (tabela 100% dedicada a um provedor) agora que um SEGUNDO
// provedor de atividade esta sendo integrado — esta e a fronteira arquitetural entre "adaptador de
// entrada" (Polar, e futuramente Strava/Garmin/COROS/etc, cada um com seu proprio mapeamento raw
// -> aqui) e "dominio Panzeri Run". StravaActivity NAO foi migrada para ca nesta tarefa (fora de
// escopo, ver ADR/tarefa de ingestao Polar de 01/10/2026), mas o desenho deste model foi pensado
// para que uma migracao futura (Strava -> RawExternalActivity -> ActivityLog) seja possivel sem
// mudar o significado dos campos abaixo.
//
// Tres niveis (normalizacao Polar -> canonico, 01/10/2026 — ver PolarActivityNormalizer):
//   RAW          = RawExternalActivity.payload (fidelidade total ao provedor, nunca tocado aqui).
//   CANONICO     = colunas desta tabela: universais o suficiente pra qualquer provedor, SEM
//                  depender de enum/nomenclatura de um fabricante especifico. "sport" em particular
//                  e SEMPRE a modalidade canonica do Panzeri Run (mesmo vocabulario de
//                  TrainingSession.modality: 'corrida' | 'esteira' | 'forca' |
//                  'fortalecimento_corredores' | 'bike' | 'outra') — NUNCA o enum bruto do
//                  provedor (ex.: Polar manda sport=RUNNING/OTHER + detailed-sport-info=
//                  STRENGTH_TRAINING; quem traduz isso pra 'corrida'/'forca' e' o adapter do
//                  provedor, nao o dominio). Um adapter Garmin/COROS/Apple futuro tera' sua propria
//                  nomenclatura de origem e devera' convergir pra este MESMO vocabulario.
//   PROVIDER-SPECIFIC = providerMetrics (Json?): metricas proprietarias ou cuja semantica depende
//                  do fabricante (Polar: runningIndex, cardioLoad/muscleLoad do Training Load Pro,
//                  perceivedLoad, userRpe, device, detailedSportInfo, percentuais de
//                  macronutriente). Ficam estruturadas (nao e' so' um blob opaco) mas a proveniencia
//                  e' sempre a coluna "provider" desta mesma linha — nunca viram variavel
//                  universal por acidente (ex.: "Polar Muscle Load" nao e' "carga muscular real do
//                  treino": e' uma metrica interpretada pelo algoritmo da Polar, documentado assim
//                  de proposito pra nao ser confundida com uma metrica equivalente de outro
//                  provedor ou calculada pelo proprio Panzeri Run).
//   Sentinelas de "indisponivel" do provedor (ex.: Polar manda muscle-load=-1 com
//   muscle-load-interpretation=NOT_AVAILABLE, ou perceived-load=0 com interpretation=
//   NOT_AVAILABLE, ou user-rpe=UNKNOWN) NUNCA viram valor numerico zero/negativo aqui nem em
//   providerMetrics — o adapter resolve pra null (ausencia de observacao), preservando o valor
//   bruto original apenas em RawExternalActivity.payload.
//
// Deliberadamente NAO modelado como coluna canonica (fica so no raw, ou vira providerMetrics):
// - pace: e sempre derivavel de distanceMeters/durationSec: persistir os tres criaria risco de
//   divergencia entre valor observado e valor calculado. Calcular sob demanda na leitura.
// - club-id/name: metadado sem equivalente canonico claro ainda — preservado so no raw.
// - cadencia/potencia/elevacao real e rota GPS: no resumo da Polar (o unico endpoint chamado nesta
//   etapa) esses dados NAO vem — dependem de endpoints separados de samples/GPX/TCX/FIT, fora do
//   escopo desta tarefa. Os campos abaixo existem no schema (para nao exigir migration quando
//   isso for implementado) mas ficam null ate la; "detailFetchedAt" existe exatamente para
//   distinguir "nunca tentamos buscar" (null) de "buscamos e o provedor nao tinha o dado" (campo
//   ainda null, mas detailFetchedAt preenchido) — null nunca deve ser lido como zero.
model ActivityLog {
  id            String              @id @default(uuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id])
  provider      String
  externalId    String
  rawActivityId String              @unique
  rawActivity   RawExternalActivity @relation(fields: [rawActivityId], references: [id])

  startedAt        DateTime
  utcOffsetMinutes Int?
  durationSec      Int?
  distanceMeters   Float?
  sport            String?

  caloriesKcal        Int?
  avgHeartRateBpm     Int?
  maxHeartRateBpm     Int?
  cadenceAvg          Int?
  powerAvgWatts       Int?
  elevationGainMeters Float?
  hasRoute            Boolean?
  detailFetchedAt     DateTime?
  providerMetrics     Json?

  // Fundacao Prescricao x Execucao (01/10/2026) — ver SessionExecutionLink abaixo. Denormalizado
  // aqui (em vez de so' derivar de "existe link ativo?") porque "alternative" e "ainda nao
  // processado" sao estados DIFERENTES e nenhum dos dois tem uma linha de link: sem este campo nao
  // daria pra distinguir "ja' decidimos que e' alternative" de "ninguem olhou pra isso ainda".
  // Mantido consistente pelo SessionExecutionLinkService, nunca escrito direto por outro lugar.
  // Valores (correcao 02/10/2026 — ver cabecalho de session-execution-link.service.ts pro modelo
  // mental completo): null (nao processado ainda) | 'corresponding' (atividade corresponde a uma
  // prescricao, tem SessionExecutionLink ativo — NAO exige execucao perfeita) | 'alternative'
  // (atividade realizada sem nenhuma prescricao aplicavel — classificacao objetiva, nunca
  // "substituicao"/"erro"/"nao aderencia intencional") | 'ambiguous' (candidato(s) existem mas sem
  // evidencia suficiente — aguarda resolucao, nunca vira 'corresponding' sozinho).
  executionClassification String?
  executionClassifiedAt   DateTime?
  // Quem/o que tomou a decisao ATUAL de classificacao (nao apenas de um link — 'alternative'
  // tambem e' uma decisao com proveniencia, mesmo sem linha de SessionExecutionLink). 'automatic' |
  // 'student' | 'coach'. Historico de decisoes anteriores fica nas linhas revogadas de
  // SessionExecutionLink quando existirem; para uma 'alternative' que nunca teve link, esta coluna
  // e' a unica proveniencia.
  executionClassifiedBy   String?

  // Identidade FISICA cross-provider (06/10/2026, Apple Etapa 2). Varios ActivityLog (Polar, HealthKit, Strava-via-HealthKit,
  // Garmin...) podem ser observacoes do MESMO evento fisico. Nenhum registro e apagado nem fundido: cada ActivityLog continua
  // com seu provider/externalId/raw/metricas/provenance, e as observacoes do mesmo evento compartilham physicalEventId (um uuid
  // gerado so' quando ha pelo menos 2 observacoes; null = nenhuma contraparte conhecida). Sem hierarquia de provider e sem
  // metricas "escolhidas": isto so' diz QUE sao o mesmo evento. NAO e reconciliacao (nada aqui liga a TrainingSession) nem
  // executionClassification.
  physicalEventId String?
  // null = nunca avaliado (historico anterior) | 'unique' = avaliado, sem contraparte | 'matched' = ha physicalEventId com >=2
  // observacoes | 'ambiguous' = ha candidato(s) proximo(s) mas a evidencia nao basta (nunca vira match sozinho).
  physicalIdentityStatus String?
  // Criterios avaliados por candidato ({activityLogId, provider, verdict, reason, criteria:[{criterion, matched: true|false|null, ...}]});
  // matched:null = dado ausente (nunca incompatibilidade). Explica a decisao, nunca a veta.
  physicalIdentityEvidence Json?
  physicalIdentityEvaluatedAt DateTime?

  executionLinks SessionExecutionLink[]
  samples        RawActivitySample[]
  timeSeriesPoints ActivityTimeSeriesPoint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, userId, externalId])
  @@index([userId, startedAt])
  @@index([physicalEventId])
}

// Ingestao de samples (02/10/2026) — serie temporal de uma atividade (FC, velocidade, distancia
// acumulada, cadencia, potencia, altitude, GPS — o que o provider efetivamente oferecer pra' aquela
// atividade especifica). Camada RAW, deliberadamente NAO canonica ainda: nao sabemos a estrutura
// real da resposta da Polar pra samples (so' os docs publicos confirmam que os endpoints existem,
// nao o formato exato) e nao conhecemos NENHUM outro provider ainda — fabricar um model canonico
// de samples agora seria desenhar em cima de suposicao, exatamente o erro que este model evita.
//
// Por que NAO 'PolarHeartRatePoint'/'PolarCadencePoint' etc.: uma tabela por metrica por provider
// nao escala (Garmin/COROS/Apple cada um com seu proprio vocabulario de tipos) e force a decidir
// equivalencia entre providers antes de ter o segundo provider integrado. Este model e' generico:
// UMA linha por (atividade, tipo de amostra), com a serie inteira preservada em `payload` tal como
// o provider devolveu — nunca interpretada/transformada aqui.
//
// `sampleType` e' o identificador do tipo EXATAMENTE como o provider o expressa (ex.: o que a
// resposta de "available samples" da Polar chamar aquele tipo — numero, slug, o que for) — nunca
// traduzido/normalizado nesta etapa. Tipo desconhecido/inesperado ainda e' preservado normalmente
// (sampleType vira o que veio, sem lista fechada de valores aceitos).
//
// Dedupe por (activityLogId, provider, sampleType): resincronizar a mesma atividade faz upsert,
// nunca duplica. Falha ao buscar samples de uma atividade NUNCA deve impedir ou reverter a
// ActivityLog/RawExternalActivity daquela atividade — essas duas continuam a fonte de verdade do
// resumo mesmo se a serie temporal nunca tiver sido buscada (fetchedAt ausente pra esse tipo so'
// significa "ainda nao tentamos", nunca "provider nao tem").
model RawActivitySample {
  id            String      @id @default(uuid())
  activityLogId String
  activityLog   ActivityLog @relation(fields: [activityLogId], references: [id])
  provider      String
  sampleType    String
  payload       Json
  // Contexto da propria busca (ex.: endpoint exato chamado, recording-rate se o provider informar)
  // — deliberadamente separado de `payload` pro mesmo motivo de RawExternalActivity.ingestionMeta:
  // nunca misturar o que o provider mandou com o que registramos sobre a coleta.
  providerMeta Json?
  fetchedAt    DateTime    @default(now())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([activityLogId, provider, sampleType])
  @@index([activityLogId])
}

// Primeira camada canonica de serie temporal (03/10/2026) — provider-agnostica, derivada de
// RawActivitySample (que continua intocado/imutavel; esta tabela e' recalculavel do zero a
// qualquer momento a partir dele). UMA linha por (atividade, offset em segundos desde o inicio),
// nao por metrica — colunas de metrica ficam null quando aquele instante nao teve leitura daquele
// tipo. Isso e' deliberado: recording-rate pode diferir entre metricas (ex.: FC a cada 1s, cadencia
// a cada 5s), e forcar todas as metricas num unico grid uniforme inventaria dados que o provider
// nunca gravou. Nenhuma interpolacao acontece em nenhum campo.
//
// Nesta primeira versao so' sao normalizados os sampleType Polar com confirmacao empirica forte
// (ver relatorio 03/10/2026): 0=FC, 1=velocidade, 2=cadencia (com transformacao, ver abaixo), 10=
// distancia acumulada. Altitude/potencia/temperatura (3/4/9) ficam SOMENTE em RawActivitySample ate
// termos confirmacao semantica suficiente — nenhuma linha desta tabela e' gerada a partir deles.
//
// Estritamente provider-agnostico (correcao 03/10/2026): nenhum campo aqui pode ter nome ou
// significado especifico de um fabricante. O valor BRUTO de qualquer metrica (ex.: a cadencia por
// perna que a Polar entrega) fica exclusivamente em RawActivitySample — nunca duplicado aqui. Se
// uma metrica canonica exigiu alguma transformacao do bruto pra chegar neste formato (ex.: Polar
// cadencia x2 pra virar passos/minuto), essa regra NAO vira uma coluna/flag nova — ela e' reconstruivel
// auditando `provider` + `normalizationVersion` desta linha contra o codigo do normalizador
// (ActivityTimeSeriesService) e o `RawActivitySample` original da mesma atividade. Evita criar uma
// coluna "transform" generica cujo UNICO uso real seria guardar nomes de regra por fabricante — o
// que seria a mesma especificidade de provider escondida atras de um nome diferente.
//
// `normalizationVersion` existe pra permitir mudar a logica de normalizacao no futuro sem apagar
// nem reescrever silenciosamente o que ja foi calculado com a logica anterior — uma nova versao
// convive com a antiga ate decisao explicita de descartar.
//
// Dedupe por (activityLogId, offsetSec, normalizationVersion): resincronizar a mesma atividade faz
// upsert por offset, nunca duplica a serie.
model ActivityTimeSeriesPoint {
  id            String      @id @default(uuid())
  activityLogId String
  activityLog   ActivityLog @relation(fields: [activityLogId], references: [id])
  provider      String
  offsetSec     Float

  heartRateBpm   Int?
  speedKmh       Float?
  distanceMeters Float?
  cadenceSpm     Int?

  normalizationVersion Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([activityLogId, offsetSec, normalizationVersion])
  @@index([activityLogId])
}

// Fundacao Prescricao x Execucao (01/10/2026). Vinculo PROVIDER-AGNOSTICO entre uma prescricao
// (TrainingSession — prescrita de verdade OU sintetica/extra, ver origin em TrainingSession) e uma
// atividade executada observada (ActivityLog, de qualquer provedor). Nunca conhece Polar/Garmin/
// Strava — so' trabalha com os dois lados ja' canonicos.
//
// Por que uma tabela nova em vez de reaproveitar WorkoutCompletion.sessionId: WorkoutCompletion e'
// 1:1 com TrainingSession (sessionId e' @unique) e representa principalmente o RELATO/feedback do
// aluno. A relacao prescricao<->atividade-executada aqui e' N:N, pode ficar ambigua por um tempo,
// precisa de proveniencia (quem/o que decidiu) e precisa ser corrigivel SEM apagar a decisao
// anterior — nada disso cabe numa FK unica. As duas tabelas coexistem: um WorkoutCompletion e um
// SessionExecutionLink podem existir para a mesma sessao, cada um preservando sua propria fonte
// (relogio mostra uma coisa, aluno relata outra — nenhum dos dois reescreve o outro).
//
// Nunca deletar uma linha: revogar = status='revoked' + revokedAt preenchido, e (quando ha'
// substituicao, nao so' remocao) supersededByLinkId aponta pra' linha nova. Isso preserva a cadeia
// "classificacao automatica -> corrigida pelo aluno -> vinculo atual" so' consultando o historico.
//
// Multiplicidade deliberadamente NAO travada em 1:1 no schema (nem por trainingSessionId nem por
// activityLogId): uma sessao pode ter 0..N atividades vinculadas (situacao real: duas atividades
// candidatas a' mesma prescricao antes de resolver qual e' a certa, ou futuramente a MESMA execucao
// chegando por dois providers — Polar e Garmin, por exemplo — sem duplicar "carga", ja' que contar
// execucao e' uma checagem de EXISTENCIA de link ativo, nao soma de linhas). O service e' quem
// evita, por padrao, duas linhas ATIVAS simultaneas pro MESMO par (trainingSessionId,
// activityLogId) — ver indice parcial na migration.
model SessionExecutionLink {
  id String @id @default(uuid())

  userId String

  trainingSessionId String
  trainingSession   TrainingSession @relation(fields: [trainingSessionId], references: [id])

  activityLogId String
  activityLog   ActivityLog @relation(fields: [activityLogId], references: [id])

  // 'active' (vinculo confirmado, conta como execucao) | 'revoked' (substituido/corrigido,
  // preservado por historico) | 'candidate' (02/10/2026, Motor de Reconciliacao V1 — proposta NAO
  // confirmada: multiplas sessoes plausiveis, ou unico candidato com evidencia insuficiente pra
  // confianca automatica, ou multiplas atividades disputando a mesma sessao. Nunca conta como
  // execucao — so' 'active' conta. Existe pra' preservar a arquitetura de confirmacao humana
  // futura: confirmar = promover a 'active' via linkManually(), que automaticamente revoga os
  // candidatos irmaos da mesma atividade).
  status String

  // Quem/o que criou ESTA linha especifica — nunca sobrescrito; uma correcao cria uma linha nova
  // com seu proprio origin, preservando a proveniencia de cada decisao na cadeia.
  origin String // 'automatic' | 'student' | 'coach'

  // Qualitativo e opcional de proposito — NUNCA um score numerico fabricado quando nao existe
  // calculo real por tras (ver principio "nao transformar probabilidade em fato"). Ex.:
  // 'same_day_modality_match' (classificacao automatica conservadora desta etapa), 'manual'.
  confidence String?
  note       String?

  // Motor de Reconciliacao V1 (02/10/2026, corrigido no mesmo dia — ver cabecalho de
  // session-execution-link.service.ts). matchMethod identifica O ALGORITMO/CAMINHO que gerou esta
  // linha ('automatic_single_candidate', 'automatic_multi_candidate',
  // 'automatic_multi_candidate_disambiguated', 'automatic_rival_activity', 'manual'); evidence e'
  // a LISTA de criterios canonicos avaliados e seu resultado (ex.: [{criterion:'same_athlete',
  // matched:true}, {criterion:'compatible_modality',matched:true}, {criterion:'distance_compatible',
  // matched:null}] — matched:null significa dado ausente, NUNCA incompatibilidade). Nunca um score
  // numerico unico fabricado — a lista de criterios E' a explicacao, nao um resumo dela. IMPORTANTE:
  // evidence explica a decisao, nunca a VETA — um vinculo 'active' pode perfeitamente ter
  // distance_compatible/duration_compatible = false (treino executado diferente do prescrito,
  // o que e' CARACTERISTICA DA EXECUCAO, nao motivo pra recusar a correspondencia).
  matchMethod String?
  evidence    Json?

  createdAt DateTime  @default(now())
  revokedAt DateTime?

  // Auto-relacao: a linha revogada aponta pra' linha que a substituiu (quando a correcao CRIA um
  // vinculo novo, em vez de so' remover). supersededByLinkId fica null quando a revogacao nao gerou
  // substituicao (ex.: virou 'alternative', sem vinculo nenhum).
  supersededByLinkId String?               @unique
  supersededByLink   SessionExecutionLink? @relation("LinkSupersession", fields: [supersededByLinkId], references: [id])
  supersedes         SessionExecutionLink? @relation("LinkSupersession")

  @@index([trainingSessionId])
  @@index([activityLogId])
  @@index([userId])
}

// Cache da analise do agente de IA sobre o historico do Strava (StravaAnalysisAgentService).
// Desacoplada de generateWeek() — a analise roda pela sua propria cadencia (mensal por padrao,
// ou a frequencia customizada por aluno definida pelo treinador via chat), nunca mais junto da
// geracao da semana. lastActivityId/analysis ficam nullable porque uma preferencia de frequencia
// pode ser definida antes de qualquer analise real ter rodado para aquele aluno.
model StravaAnalysisCache {
  userId              String   @id
  lastActivityId      String?
  analysis            Json?
  // Frequencia customizada (em dias) definida pelo treinador para este aluno especifico via chat
  // do Gerente Tecnico — null usa o padrao mensal (30 dias, ver StravaAnalysisSchedulerService).
  customFrequencyDays Int?
  updatedAt           DateTime @updatedAt
}

// Tentativa OAuth Strava de uso unico (05/10/2026): o state nunca e' persistido em texto puro (so' o hash), expira
// em minutos, e' consumido de forma atomica no callback e fica vinculado ao usuario que a iniciou.
model StravaOAuthAttempt {
  stateHash  String    @id
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Deduplicacao dos eventos de webhook do Strava (05/10/2026): o Strava nao assina os eventos e reenvia ate 3 vezes;
// a chave (hash de tipo/objeto/aspecto/dono/hora/updates) torna o processamento idempotente. Sem PII; expira em 7 dias.
model StravaWebhookEvent {
  dedupeKey  String   @id
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}

model StravaActivity {
  id             String   @id @default(uuid())
  userId         String
  stravaId       String   @unique
  name           String?
  type           String?
  startDate      DateTime
  distanceKm     Float?
  movingTimeSec  Int?
  // Tempo total decorrido da atividade (inclui paradas reais — semaforo, agua parada etc.),
  // diferente de movingTimeSec (que o proprio Strava ja tenta excluir parada total, mas NAO
  // exclui caminhada, que ainda conta como "em movimento"). Um gap grande entre os dois e sinal
  // de paradas reais; nao ajuda a detectar caminhada dentro do treino.
  elapsedTimeSec Int?
  avgPaceSecKm   Int?
  avgHeartRate   Int?
  maxHeartRate   Int?
  cadence        Int?
  // Ganho de elevacao total (metros) — usado pelo agente de analise do Strava pra contextualizar
  // pace/cadencia mais lentos (subida) em vez de interpretar isso como fadiga ou caminhada.
  elevationGainM Float?
  raw            Json
  createdAt      DateTime @default(now())
  // Quando esta atividade foi buscada pela ULTIMA vez na API do Strava. O cache Strava expira 7 dias depois
  // (StravaService.purgeExpiredData); por isso e' fetchedAt, nao createdAt, que governa a retencao.
  fetchedAt      DateTime @default(now())
}

// Sistema de Medalhas (30/09/2026, especificacao completa em SISTEMA_DE_MEDALHAS.md) — tabelas
// Achievement/UserAchievement ja existiam no schema desde antes, mas nunca foram usadas por
// nenhum codigo (achado da auditoria de dados feita antes de desenhar este sistema). Estendidas
// aqui em vez de criar um sistema concorrente — nenhuma tabela de catalogo nova.
model Achievement {
  id          String            @id @default(uuid())
  code        String            @unique
  // constancia | aderencia | treinos_concluidos | volume_semanal | sustentacao_volume |
  // volume_mensal | distancia_unica | acumulado | feedbacks | checkins | reavaliacoes | provas |
  // retomada — ver MedalCategory em medals/medal-catalog.ts.
  category    String            @default("")
  name        String
  description String
  // bronze | prata | ouro | platina | diamante | lendaria — atributo visual/de dificuldade, nunca
  // pontuacao fisiologica (ver SISTEMA_DE_MEDALHAS.md secao 15).
  grau        String            @default("bronze")
  // Limiar numerico do criterio (km, semanas, contagem, %...). Nullable pra medalhas cujo criterio
  // nao e' um numero simples (nenhuma prevista ainda, mas evita forcar 0 como "sem limiar").
  threshold   Float?
  unit        String? // "km" | "semanas" | "treinos" | "checkins" | "%" | null
  ruleVersion Int               @default(1)
  // Parametros estruturados extras: modalidade, numero de semanas consecutivas exigido, tipo de
  // periodo (semana/mes/sessao/all-time), patamar-pai (familia de sustentacao de volume) etc —
  // NUNCA logica, so' dado que o MedalEvaluationService le.
  criteria    Json
  // Ordem dentro da familia (mesma categoria), usada pra progressao/"proxima conquista" — nunca
  // pra decidir qual medalha mostrar sozinha (ver SISTEMA_DE_MEDALHAS.md secao 16).
  sortOrder   Int               @default(0)
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  users       UserAchievement[]

  @@index([category])
}

model UserAchievement {
  id                  String      @id @default(uuid())
  userId              String
  user                User        @relation(fields: [userId], references: [id])
  achievementId       String
  achievement         Achievement @relation(fields: [achievementId], references: [id])
  unlockedAt          DateTime    @default(now())
  // Valor EFETIVAMENTE OBSERVADO que gerou a conquista (execucao real — ver regra central em
  // SISTEMA_DE_MEDALHAS.md). Nullable pra medalhas de participacao/processo sem valor numerico
  // proprio (ex: "1o feedback enviado" pode usar value=1 mesmo assim, mas o campo fica opcional
  // pra nao forcar um numero artificial onde nao faz sentido).
  value               Float?
  // Periodo correspondente (semana/mes/sessao) — null quando a medalha e' all-time (ex: acumulado).
  periodStart         DateTime?
  periodEnd           DateTime?
  modality            String? // corrida | esteira | null quando nao aplicavel
  // Rastreabilidade: sessionIds/completionIds/weekStart/checkinIds/reassessmentId — nunca "confie,
  // aconteceu". Usado tambem pra auditoria e pra futura inteligencia gerencial (secao 18).
  evidence            Json
  // Snapshot da versao da regra NO MOMENTO da conquista — sobrevive a mudancas futuras na definicao
  // da medalha (uma conquista sob a regra v1 nunca e' reavaliada/revogada quando a regra vira v2).
  ruleVersionAtUnlock Int         @default(1)
  createdAt           DateTime    @default(now())

  @@unique([userId, achievementId])
  @@index([userId, unlockedAt])
  // Etapa 8 (30/09/2026) — base pra inteligência gerencial futura (SISTEMA_DE_MEDALHAS.md seção
  // 18): "quantos alunos já conquistaram a medalha X" é uma consulta POR achievementId sozinho,
  // que o índice composto (userId, achievementId) acima não atende bem. Só o índice — nenhum
  // endpoint/agregação implementado ainda, por pedido explícito (preparar a base, não construir
  // o painel).
  @@index([achievementId])
}

model Challenge {
  id          String              @id @default(uuid())
  code        String              @unique
  name        String
  description String
  type        String
  criteria    Json
  active      Boolean             @default(true)
  progress    ChallengeProgress[]
}

model ChallengeProgress {
  id          String    @id @default(uuid())
  userId      String
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id])
  weekStart   DateTime
  progress    Json
  completed   Boolean   @default(false)
}

// 04/09: lista de e-mails de testadores gratuitos (Play Store, teste fechado) que o proprio
// treinador gerencia direto no admin — sem isso, qualquer testador que tentasse assinar caia no
// fluxo antigo (Asaas, cobranca real), ja que o build de teste ainda nao tem a chave do
// RevenueCat. Antes de existir essa tabela, a lista ficava hardcoded no codigo — errado, pois
// nao escalava (cada testador novo exigia deploy). Ver createCheckout em billing.service.ts.
model FreeTesterEmail {
  id        String   @id @default(uuid())
  email     String   @unique
  note      String?
  createdAt DateTime @default(now())
}

model Coupon {
  id              String             @id @default(uuid())
  code            String             @unique
  name            String
  discountPercent Int                @default(100)
  active          Boolean            @default(true)
  usageCount      Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  redemptions     CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(uuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([couponId, userId])
  @@index([userId])
}

model CoachReport {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  reportType String
  title      String
  content    Json
  createdAt  DateTime @default(now())

  @@index([userId, reportType, createdAt])
}

// Registro bruto do prontuario, gerado inteiramente por codigo (nunca por IA) toda vez que algo
// relevante acontece com o aluno (entrevista concluida, treino gerado, treino registrado,
// diretriz, observacao, dor, reavaliacao). Zero custo de IA para criar essas linhas — e so
// formatacao de texto. O agente do prontuario (StudentProfileAgentService) le as linhas com
// summarizedAt nulo pra saber exatamente o que e novo desde a ultima atualizacao do resumo, sem
// nunca precisar reler o historico inteiro de novo.
model StudentProfileEvent {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  code         String
  content      String
  createdAt    DateTime  @default(now())
  summarizedAt DateTime?

  @@index([userId, summarizedAt])
}

// O prontuario em si: um resumo curto e continuamente atualizado, pensado pra substituir o
// motor de prescricao tendo que re-deduzir padroes do aluno a partir de numeros crus toda semana
// — a mesma logica que um treinador real usa (memoria acumulada do aluno, atualizada aos poucos,
// nunca reconstruida do zero).
model StudentProfile {
  userId    String   @id
  summary   String   @default("")
  updatedAt DateTime @updatedAt
}

// Linha do Tempo de Relatos (28/09/2026) — toda vez que o aluno escreve texto livre em qualquer
// lugar do app, uma linha e' criada aqui, preservando o texto ORIGINAL pra sempre (nunca alterado).
// O Agente Relator (StudentReporterAgentService) preenche os campos de analise depois, de forma
// assincrona e melhor-esforco (analyzedAt nulo = ainda nao analisado ou falhou — nunca bloqueia o
// salvamento do dado original). sourceType e' string livre de proposito (nao um enum fechado do
// Prisma) pra permitir novas fontes de texto no futuro sem migration. Este e' o INSUMO do futuro
// Agente de Prontuario, mas ainda NAO esta conectado a ele (StudentProfileService) — essa integracao
// e' proposital e explicitamente uma etapa futura, nao desta implementacao.
model StudentReportEntry {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Identifica de onde veio o texto (ex: 'workout_feedback_notes', 'workout_missed_comment',
  // 'workout_adjustment_comment', 'pain_report', 'weekly_checkin_free_text', 'student_observation',
  // 'context_event', 'onboarding_interview_health', 'reassessment_health',
  // 'subscription_cancel_feedback') — ver STUDENT_REPORT_SOURCE_TYPES em reporter/report-timeline.constants.ts.
  sourceType     String
  // Id da linha de origem (WorkoutCompletion/PainReport/ContextEvent/etc), quando existir — permite
  // voltar ao registro original completo, alem do texto ja preservado abaixo.
  sourceId       String?
  // Pergunta/rotulo que originou a resposta, quando aplicavel (ex: "O que poderia ter sido
  // diferente?"). Null quando o campo nao tem uma pergunta fixa associada.
  promptQuestion String?
  // Descricao curta e legivel do contexto relacionado (ex: "Treino de 28/09 - corrida"), pra exibir
  // na timeline sem precisar buscar a linha de origem.
  relatedLabel   String?

  // Texto original do aluno — NUNCA alterado pela interpretacao da IA. Fonte historica.
  originalText String
  // Data/hora do evento de origem (quando o relato se refere), nao da criacao desta linha.
  occurredAt   DateTime

  // Saida estruturada do Agente Relator — tudo nulo/vazio ate ser processado.
  analyzedAt       DateTime?
  facts            String?
  perception       String?
  themes           String[]
  temporality      String? // ATUAL | PASSADO | RECORRENTE | RESOLVIDO | EXPECTATIVA_FUTURA | PERSISTENTE_ATE_CONTRARIO | INDETERMINADO
  longitudinalNote String?
  hypotheses       String[]
  relevance        String? // PONTUAL | ACOMPANHAR | LONGITUDINAL | MUDANCA_IMPORTANTE
  // Motivo da falha quando a analise nao completar (nunca trava o texto original) — best-effort,
  // mesmo padrao ja usado pelos outros agentes desta arquitetura.
  analysisError    String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, sourceType])
  @@index([userId, analyzedAt])
}

// Rastreamento de funil de onboarding (07/09): cada evento relevante do prospecto/aluno desde
// a abertura do app ate o pagamento. sessionId e um UUID anonimo gerado no cliente (AsyncStorage)
// antes de qualquer criacao de conta — permite medir abandono pre-cadastro. userId e preenchido
// assim que a conta e criada e linkado ao mesmo sessionId. Eventos disparados so pelo cliente
// (fire-and-forget, nunca bloqueia a UI). Dados aqui sao operacionais/internos: o treinador
// ve quantas pessoas entram e onde travam — nenhum dado de saude ou senha passa por aqui.
model FunnelEvent {
  id         String   @id @default(cuid())
  // UUID gerado no cliente e guardado em AsyncStorage — persiste entre sessoes do app enquanto
  // o usuario nao reinstala. Permite rastrear o mesmo prospecto atraves de multiplas visitas.
  sessionId  String
  // Identificador anonimo e persistente da jornada, criado antes do cadastro na landing/PWA.
  journeyId  String?
  // Preenchido pelo cliente assim que a conta e criada — vincula o historico anonimo ao usuario.
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  // Tipo do evento: app_opened | signup_started | signup_error | signup_completed |
  // interview_started | question_answered | question_error | interview_completed |
  // payment_started | payment_completed | landing_view | landing_cta_click | journey_linked |
  // routine_configured | first_plan_generated (22/09: fecha o funil pos-pagamento pro Leo/Intelligence)
  event      String
  // Qual pergunta da entrevista (key da pergunta, ex: 'personal_weight') — so em question_*
  questionId String?
  // Dados complementares: mensagem de erro, utm_source, user agent, etc. Sem dados sensiveis.
  metadata   Json?
  // Chave opcional de idempotencia. Permite que marcos unicos sejam reenviados com seguranca.
  dedupeKey  String?  @unique
  createdAt  DateTime @default(now())

  @@index([sessionId])
  @@index([journeyId])
  @@index([userId])
  @@index([event, createdAt])
}

model BillingEvent {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  event       String
  prevStatus  String?
  nextStatus  String?
  value       Decimal?
  timestamp   DateTime @default(now())
  externalRef String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([event])
  @@index([timestamp])
}

// Meus Tenis (04/10/2026). Cadastro do par — NUNCA armazena km/numero de treinos acumulados aqui:
// esses sao sempre derivados em tempo de leitura a partir das ShoeUsage ligadas (ver
// ShoesService), nunca uma segunda verdade cacheada. "status" controla so' se o par aparece como
// OPCAO PRINCIPAL pra novos feedbacks — aposentar nunca apaga nem desvincula historico.
model Shoe {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  brand    String
  model    String
  nickname String?
  // Nullable de proposito: nao existe infraestrutura de upload de imagem no projeto ainda (sem
  // multer/S3/storage) — ver diagnostico do bloco "Meus Tenis". Campo existe pro dado ter onde
  // morar quando essa infra existir, mas esta etapa nao constroi picker/upload nenhum.
  photoUrl String?

  startedUsingAt DateTime
  // 'active' | 'retired'. Aposentar NAO exclui nem desvincula ShoeUsage — so' tira o par da lista
  // de opcoes principais no formulario de feedback (ver ShoesController/mobile).
  status         String    @default("active")
  retiredAt      DateTime?

  usages ShoeUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

// Vinculo tenis <-> atividade realizada (04/10/2026). Chave pela WorkoutCompletion (nao
// diretamente por TrainingSession/ActivityLog) porque e' ali, no formulario de feedback, que o
// aluno informa qual par usou — e WorkoutCompletion ja' representa uniformemente "uma execucao
// com contexto", seja ela prescrita, extra manual (student_extra) ou materializada a partir de
// ActivityLog (device_extra/alternative). @unique em workoutCompletionId: no maximo UM tenis por
// execucao, trocar = atualizar esta linha (nunca empilha historico de correcao aqui — ver
// ShoesService.setUsage; a trilha de proveniencia fina pertence a SessionExecutionLink, nao a
// este vinculo mais simples).
//
// Quilometragem: NUNCA lida direto de WorkoutCompletion.distanceKm quando a sessao tiver um
// SessionExecutionLink ativo pra' uma ActivityLog — nesse caso a atividade canonica (ActivityLog.
// distanceMeters) e' a fonte, por ser corrigivel/atualizavel independente do que o aluno digitou
// no feedback (ver ShoesService.resolveDistanceKm). Sem link ativo (treino manual sem relogio),
// WorkoutCompletion.distanceKm e' a unica fonte existente — nunca inventa distancia.
model ShoeUsage {
  id                  String            @id @default(uuid())
  shoeId              String
  shoe                Shoe              @relation(fields: [shoeId], references: [id])
  workoutCompletionId String            @unique
  workoutCompletion   WorkoutCompletion @relation(fields: [workoutCompletionId], references: [id])
  userId              String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shoeId])
  @@index([userId])
}
